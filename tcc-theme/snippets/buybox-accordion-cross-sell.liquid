{%- comment -%}
  buybox-accordion-cross-sell.liquid
  Variables: block (the section block object)
  Usage: {% render 'buybox-accordion-cross-sell', block: block %}
{%- endcomment -%}

<details class="buybox-acc-xsell" {{ block.shopify_attributes }}>
  <summary class="buybox-acc-xsell__summary">
    <span class="buybox-acc-xsell__title">{{ block.settings.title }}</span>
    <svg class="buybox-acc-xsell__chevron" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" aria-hidden="true">
      <path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </summary>

  <div class="buybox-acc-xsell__body">
    {%- if block.settings.intro != blank -%}
      <div class="buybox-acc-xsell__intro">{{ block.settings.intro }}</div>
    {%- endif -%}

    {%- assign has_products = false -%}
    {%- if block.settings.product_1 != blank or block.settings.product_2 != blank or block.settings.product_3 != blank -%}
      {%- assign has_products = true -%}
    {%- endif -%}

    {%- if has_products -%}
      <div class="buybox-acc-xsell__cards">

        {%- comment -%}Cross-sell product 1{%- endcomment -%}
        {%- if block.settings.product_1 != blank -%}
          {%- assign xp1 = block.settings.product_1 -%}
          <div class="buybox-acc-xsell__card">
            <a class="buybox-acc-xsell__card-link" href="{{ xp1.url }}">
              {%- if xp1.featured_image != blank -%}
                <img
                  class="buybox-acc-xsell__card-img"
                  src="{{ xp1.featured_image | image_url: width: 120 }}"
                  alt="{{ xp1.title | escape }}"
                  width="60"
                  height="60"
                  loading="lazy"
                >
              {%- else -%}
                <div class="buybox-acc-xsell__card-img buybox-acc-xsell__card-img--placeholder"></div>
              {%- endif -%}
            </a>
            <div class="buybox-acc-xsell__card-info">
              <a class="buybox-acc-xsell__card-title" href="{{ xp1.url }}">{{ xp1.title }}</a>
              <span class="buybox-acc-xsell__card-price">{{ xp1.price | money }}</span>
            </div>
            <a class="buybox-acc-xsell__card-atc tcc-btn" href="{{ xp1.url }}">Add</a>
          </div>
        {%- endif -%}

        {%- comment -%}Cross-sell product 2{%- endcomment -%}
        {%- if block.settings.product_2 != blank -%}
          {%- assign xp2 = block.settings.product_2 -%}
          <div class="buybox-acc-xsell__card">
            <a class="buybox-acc-xsell__card-link" href="{{ xp2.url }}">
              {%- if xp2.featured_image != blank -%}
                <img
                  class="buybox-acc-xsell__card-img"
                  src="{{ xp2.featured_image | image_url: width: 120 }}"
                  alt="{{ xp2.title | escape }}"
                  width="60"
                  height="60"
                  loading="lazy"
                >
              {%- else -%}
                <div class="buybox-acc-xsell__card-img buybox-acc-xsell__card-img--placeholder"></div>
              {%- endif -%}
            </a>
            <div class="buybox-acc-xsell__card-info">
              <a class="buybox-acc-xsell__card-title" href="{{ xp2.url }}">{{ xp2.title }}</a>
              <span class="buybox-acc-xsell__card-price">{{ xp2.price | money }}</span>
            </div>
            <a class="buybox-acc-xsell__card-atc tcc-btn" href="{{ xp2.url }}">Add</a>
          </div>
        {%- endif -%}

        {%- comment -%}Cross-sell product 3{%- endcomment -%}
        {%- if block.settings.product_3 != blank -%}
          {%- assign xp3 = block.settings.product_3 -%}
          <div class="buybox-acc-xsell__card">
            <a class="buybox-acc-xsell__card-link" href="{{ xp3.url }}">
              {%- if xp3.featured_image != blank -%}
                <img
                  class="buybox-acc-xsell__card-img"
                  src="{{ xp3.featured_image | image_url: width: 120 }}"
                  alt="{{ xp3.title | escape }}"
                  width="60"
                  height="60"
                  loading="lazy"
                >
              {%- else -%}
                <div class="buybox-acc-xsell__card-img buybox-acc-xsell__card-img--placeholder"></div>
              {%- endif -%}
            </a>
            <div class="buybox-acc-xsell__card-info">
              <a class="buybox-acc-xsell__card-title" href="{{ xp3.url }}">{{ xp3.title }}</a>
              <span class="buybox-acc-xsell__card-price">{{ xp3.price | money }}</span>
            </div>
            <a class="buybox-acc-xsell__card-atc tcc-btn" href="{{ xp3.url }}">Add</a>
          </div>
        {%- endif -%}

      </div>
    {%- endif -%}
  </div>
</details>

<style>
  .buybox-acc-xsell {
    border-bottom: 1px solid var(--tcc-line, #e0e0e0);
    margin-bottom: 0;
  }

  .buybox-acc-xsell__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .buybox-acc-xsell__summary::-webkit-details-marker {
    display: none;
  }

  .buybox-acc-xsell__title {
    font-family: var(--tcc-font-sans);
    font-size: 15px;
    font-weight: 700;
    color: var(--tcc-ink);
  }

  .buybox-acc-xsell__chevron {
    flex-shrink: 0;
    color: var(--tcc-ink);
    transition: transform 0.2s ease;
  }

  .buybox-acc-xsell[open] .buybox-acc-xsell__chevron {
    transform: rotate(180deg);
  }

  .buybox-acc-xsell__body {
    padding: 0 0 16px 0;
  }

  .buybox-acc-xsell__intro {
    font-family: var(--tcc-font-sans);
    font-size: 13.5px;
    color: var(--tcc-ink-soft);
    line-height: 1.6;
    margin-bottom: 12px;
  }

  .buybox-acc-xsell__intro p {
    margin: 0;
  }

  .buybox-acc-xsell__cards {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .buybox-acc-xsell__card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    background: var(--tcc-bg, #f9f9f9);
    border: 1px solid var(--tcc-line, #e0e0e0);
    border-radius: 8px;
  }

  .buybox-acc-xsell__card-link {
    flex-shrink: 0;
    display: block;
    text-decoration: none;
  }

  .buybox-acc-xsell__card-img {
    width: 60px;
    height: 60px;
    border-radius: 6px;
    object-fit: contain;
    background: #fff;
    display: block;
  }

  .buybox-acc-xsell__card-img--placeholder {
    background: linear-gradient(135deg, #e0e0e0 0%, #c8c8c8 100%);
  }

  .buybox-acc-xsell__card-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .buybox-acc-xsell__card-title {
    font-family: var(--tcc-font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--tcc-ink);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .buybox-acc-xsell__card-title:hover {
    text-decoration: underline;
  }

  .buybox-acc-xsell__card-price {
    font-family: var(--tcc-font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--tcc-ink-soft);
  }

  .buybox-acc-xsell__card-atc {
    flex-shrink: 0;
    padding: 7px 14px;
    background: var(--tcc-ink);
    color: #fff;
    font-family: var(--tcc-font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    border-radius: 6px;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s ease;
    display: inline-block;
  }

  .buybox-acc-xsell__card-atc:hover {
    opacity: 0.85;
    color: #fff;
    text-decoration: none;
  }

  @media screen and (max-width: 599px) {
    .buybox-acc-xsell__card {
      flex-wrap: wrap;
    }

    .buybox-acc-xsell__card-atc {
      flex-basis: 100%;
      text-align: center;
    }
  }
</style>
