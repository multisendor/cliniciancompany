{%- comment -%}
  buybox-member-callout.liquid
  Variables: block (the section block object)
  Usage: {% render 'buybox-member-callout', block: block %}
{%- endcomment -%}

{%- if block.settings.label != blank -%}
  <div class="buybox-member-callout" {{ block.shopify_attributes }}>
    {%- if block.settings.url != blank -%}
      <a class="buybox-member-callout__link" href="{{ block.settings.url }}">
        <svg class="buybox-member-callout__icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" width="15" height="15" aria-hidden="true">
          <circle cx="10" cy="7" r="3.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M3 17c0-3.314 3.134-6 7-6s7 2.686 7 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span class="buybox-member-callout__label">{{ block.settings.label }}</span>
        <svg class="buybox-member-callout__arrow" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="14" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    {%- else -%}
      <div class="buybox-member-callout__link buybox-member-callout__link--no-href">
        <svg class="buybox-member-callout__icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" width="15" height="15" aria-hidden="true">
          <circle cx="10" cy="7" r="3.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M3 17c0-3.314 3.134-6 7-6s7 2.686 7 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span class="buybox-member-callout__label">{{ block.settings.label }}</span>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

<style>
  .buybox-member-callout {
    margin-bottom: 10px;
  }

  .buybox-member-callout__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--tcc-ink);
    text-decoration: none;
    font-family: var(--tcc-font-sans);
    font-size: 13px;
    font-weight: 600;
    padding: 5px 0;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease, opacity 0.15s ease;
  }

  a.buybox-member-callout__link:hover {
    border-bottom-color: var(--tcc-ink);
    opacity: 0.85;
  }

  .buybox-member-callout__icon {
    flex-shrink: 0;
    color: var(--tcc-positive, #05B890);
  }

  .buybox-member-callout__arrow {
    flex-shrink: 0;
    color: var(--tcc-ink-soft);
  }

  .buybox-member-callout__label {
    line-height: 1;
  }
</style>
