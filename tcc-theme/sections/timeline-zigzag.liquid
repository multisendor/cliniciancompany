<div
  data-section-type="timeline-zigzag"
  class="timeline-zigzag tcc-section-padding"
>
  <div class="timeline-zigzag__inner tcc-page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="timeline-zigzag__heading tcc-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="timeline-zigzag__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign side = 'right' -%}
          {%- assign idx = forloop.index0 -%}
          {%- cycle 'left', 'right' -%}
          {%- if forloop.index0 | modulo: 2 == 0 -%}
            {%- assign side = 'right' -%}
          {%- else -%}
            {%- assign side = 'left' -%}
          {%- endif -%}
          <li
            class="timeline-zigzag__row timeline-zigzag__row--{{ side }}"
            {{ block.shopify_attributes }}
          >
            <div class="timeline-zigzag__label">
              <span class="timeline-zigzag__label-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
              </span>
              <span class="timeline-zigzag__label-text">{{ block.settings.time_label }}</span>
            </div>

            <div class="timeline-zigzag__node" aria-hidden="true">
              <span class="timeline-zigzag__node-inner"></span>
            </div>

            <div class="timeline-zigzag__card">
              <div class="timeline-zigzag__card-text tcc-body">
                {{ block.settings.description }}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.show_cta -%}
      <div class="timeline-zigzag__cta-wrap">
        <a
          class="timeline-zigzag__cta"
          href="{{ section.settings.cta_link | default: '/products/spike-detox' }}"
        >
          {{ section.settings.cta_text | default: 'BUY NOW & SAVE' }}
        </a>
        {%- if section.settings.guarantee_text != blank -%}
          <p class="timeline-zigzag__guarantee">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"/>
              <polyline points="9,12 11,14 15,10"/>
            </svg>
            <span>{{ section.settings.guarantee_text }}</span>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  /* Zigzag timeline — Resilia layout, TCC theme-accent colors */
  .timeline-zigzag {
    background: #ffffff;
  }

  .timeline-zigzag__inner {
    max-width: 1100px;
  }

  .timeline-zigzag__heading {
    font-size: 40px;
    line-height: 1.15;
    font-weight: 700;
    color: #0a1628;
    text-align: center;
    margin: 0 0 48px;
    letter-spacing: normal;
  }

  /* ----- Desktop zigzag ----- */
  .timeline-zigzag__list {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Center vertical dotted line (Resilia: small reddish-maroon dots) */
  .timeline-zigzag__list::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background-image: radial-gradient(circle, #b91c1c 1px, transparent 1.5px);
    background-size: 2px 8px;
    background-repeat: repeat-y;
    background-position: center top;
  }

  .timeline-zigzag__row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 56px 1fr;
    align-items: center;
    column-gap: 24px;
    min-height: 120px;
    padding: 18px 0;
  }

  /* Node sits on the center line */
  .timeline-zigzag__node {
    grid-column: 2;
    grid-row: 1;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #ffffff;
    border: 3px solid var(--tcc-cta-accent, #1e40af);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    z-index: 1;
    box-shadow: 0 0 0 4px #ffffff;
  }
  .timeline-zigzag__node-inner {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--tcc-cta-accent, #1e40af);
    display: block;
  }

  /* Label cell — icon + bold time text */
  .timeline-zigzag__label {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--tcc-cta-accent, #1e40af);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .timeline-zigzag__label-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--tcc-cta-accent, #1e40af);
    flex-shrink: 0;
  }
  .timeline-zigzag__label-text { display: inline-block; }

  /* Card — bordered description */
  .timeline-zigzag__card {
    position: relative;
    background: #ffffff;
    border: 2px solid var(--tcc-cta-accent, #1e40af);
    border-radius: 10px;
    padding: 20px 22px;
    color: #2a2a2a;
    font-size: 15px;
    line-height: 1.55;
  }
  .timeline-zigzag__card-text p { margin: 0; }
  .timeline-zigzag__card-text p + p { margin-top: 0.5rem; }

  /* Triangle tail pointing toward the line */
  .timeline-zigzag__card::before,
  .timeline-zigzag__card::after {
    content: '';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 0;
    border-style: solid;
  }

  /* Row variant: label LEFT, card RIGHT */
  .timeline-zigzag__row--right .timeline-zigzag__label {
    grid-column: 1;
    grid-row: 1;
    justify-content: flex-end;
    text-align: right;
  }
  .timeline-zigzag__row--right .timeline-zigzag__card {
    grid-column: 3;
    grid-row: 1;
  }
  .timeline-zigzag__row--right .timeline-zigzag__card::before {
    left: -10px;
    border-width: 8px 10px 8px 0;
    border-color: transparent var(--tcc-cta-accent, #1e40af) transparent transparent;
  }
  .timeline-zigzag__row--right .timeline-zigzag__card::after {
    left: -7px;
    border-width: 7px 9px 7px 0;
    border-color: transparent #ffffff transparent transparent;
  }

  /* Row variant: card LEFT, label RIGHT */
  .timeline-zigzag__row--left .timeline-zigzag__card {
    grid-column: 1;
    grid-row: 1;
  }
  .timeline-zigzag__row--left .timeline-zigzag__label {
    grid-column: 3;
    grid-row: 1;
    justify-content: flex-start;
    text-align: left;
  }
  .timeline-zigzag__row--left .timeline-zigzag__card::before {
    right: -10px;
    border-width: 8px 0 8px 10px;
    border-color: transparent transparent transparent var(--tcc-cta-accent, #1e40af);
  }
  .timeline-zigzag__row--left .timeline-zigzag__card::after {
    right: -7px;
    border-width: 7px 0 7px 9px;
    border-color: transparent transparent transparent #ffffff;
  }

  /* ----- Bottom CTA cluster (same pattern as bottom-faq) ----- */
  .timeline-zigzag__cta-wrap {
    margin: 48px auto 0;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .timeline-zigzag__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: var(--tcc-cta-accent, #1e40af);
    color: #f6f9fe;
    text-decoration: none;
    border-radius: 30px;
    padding: 18px 24px;
    font-size: 18px;
    line-height: 27.54px;
    font-weight: 700;
    letter-spacing: 0.36px;
    text-transform: uppercase;
    transition: filter 0.2s ease;
  }
  .timeline-zigzag__cta:hover { filter: brightness(0.88); color: #f6f9fe; }

  .timeline-zigzag__guarantee {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #0a1628;
    margin: 0;
  }
  .timeline-zigzag__guarantee svg { color: #0a1628; }

  /* ----- Mobile: stacked, dotted line on the left ----- */
  @media screen and (max-width: 749px) {
    .timeline-zigzag__heading {
      font-size: 28px;
      margin-bottom: 32px;
    }
    .timeline-zigzag__list::before {
      left: 18px;
      transform: none;
    }
    .timeline-zigzag__row {
      grid-template-columns: 36px 1fr;
      grid-template-rows: auto auto;
      column-gap: 18px;
      row-gap: 10px;
      min-height: 0;
      padding: 12px 0 20px;
    }
    /* Reset both variants to the same mobile layout */
    .timeline-zigzag__row--right .timeline-zigzag__label,
    .timeline-zigzag__row--left  .timeline-zigzag__label {
      grid-column: 2;
      grid-row: 1;
      justify-content: flex-start;
      text-align: left;
      font-size: 22px;
      gap: 10px;
    }
    .timeline-zigzag__row--right .timeline-zigzag__card,
    .timeline-zigzag__row--left  .timeline-zigzag__card {
      grid-column: 2;
      grid-row: 2;
      font-size: 14px;
      padding: 16px 18px;
    }
    .timeline-zigzag__node {
      grid-column: 1;
      grid-row: 1;
      width: 28px;
      height: 28px;
      border-width: 3px;
      margin: 4px 0 0 0;
      align-self: start;
    }
    .timeline-zigzag__node-inner { width: 11px; height: 11px; }
    .timeline-zigzag__label-icon { width: 28px; height: 28px; }
    .timeline-zigzag__label-icon svg { width: 22px; height: 22px; }

    /* Triangle tail: always point LEFT toward the line on mobile */
    .timeline-zigzag__row--right .timeline-zigzag__card::before,
    .timeline-zigzag__row--left  .timeline-zigzag__card::before {
      left: -10px;
      right: auto;
      top: 24px;
      transform: none;
      border-width: 8px 10px 8px 0;
      border-color: transparent var(--tcc-cta-accent, #1e40af) transparent transparent;
    }
    .timeline-zigzag__row--right .timeline-zigzag__card::after,
    .timeline-zigzag__row--left  .timeline-zigzag__card::after {
      left: -7px;
      right: auto;
      top: 24px;
      transform: none;
      border-width: 7px 9px 7px 0;
      border-color: transparent #ffffff transparent transparent;
    }

    .timeline-zigzag__cta {
      font-size: 16px;
      line-height: 24.48px;
      letter-spacing: 0.32px;
      padding: 16px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Timeline Zigzag",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What You Might Expect from Daily Use of Spike Detox"
    },
    { "type": "header", "content": "Bottom CTA (Resilia-style)" },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show BUY NOW pill + guarantee row",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "BUY NOW & SAVE"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "30-Day Money Back Guarantee"
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        {
          "type": "text",
          "id": "time_label",
          "label": "Time label",
          "default": "1 Week"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>What users typically experience by this point.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Timeline Zigzag",
      "blocks": [
        { "type": "milestone", "settings": { "time_label": "1 Week", "description": "<p>Body adjusts to fibrinolytic activity over 5–7 days.</p>" } },
        { "type": "milestone", "settings": { "time_label": "1 Month", "description": "<p>Stable cadence established.</p>" } }
      ]
    }
  ]
}
{% endschema %}
