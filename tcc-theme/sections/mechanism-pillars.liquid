<div
  class="mechanism-pillars tcc-section-padding"
  data-section-type="mechanism-pillars"
  data-section-id="{{ section.id }}"
>
  <div class="tcc-page-width">
    <div class="mechanism-pillars__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mechanism-pillars__eyebrow tcc-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="mechanism-pillars__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="mechanism-pillars__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="mechanism-pillars__grid">
        {%- for block in section.blocks -%}
          <article class="mechanism-pillars__pillar" {{ block.shopify_attributes }}>
            {%- if block.settings.pillar_number != blank -%}
              <div class="mechanism-pillars__number">{{ block.settings.pillar_number }}</div>
            {%- endif -%}
            {%- if block.settings.pillar_title != blank -%}
              <h3 class="mechanism-pillars__pillar-title">{{ block.settings.pillar_title }}</h3>
            {%- endif -%}
            {%- if block.settings.pillar_description != blank -%}
              <p class="mechanism-pillars__pillar-description">{{ block.settings.pillar_description }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .mechanism-pillars {
    background: var(--tcc-bg);
  }

  .mechanism-pillars__header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto var(--tcc-s-6, 48px);
  }

  .mechanism-pillars__eyebrow {
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-eyebrow, 11px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--tcc-ink-soft);
    margin: 0 0 var(--tcc-s-2, 16px);
  }

  .mechanism-pillars__heading {
    font-family: var(--tcc-font-heading);
    font-weight: 500;
    font-size: var(--tcc-fs-h2, clamp(24px, 3vw, 32px));
    color: var(--tcc-ink);
    margin: 0 0 var(--tcc-s-2, 16px);
    line-height: 1.2;
  }

  .mechanism-pillars__intro {
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-body, 16px);
    color: var(--tcc-ink-soft);
    line-height: 1.65;
    margin: 0;
  }

  .mechanism-pillars__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--tcc-s-3, 24px);
  }

  .mechanism-pillars__pillar {
    background: var(--tcc-card);
    border: 1px solid var(--tcc-line);
    border-radius: var(--tcc-radius, 6px);
    padding: var(--tcc-s-4, 32px);
    box-shadow: var(--tcc-shadow-card);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .mechanism-pillars__pillar:hover {
    transform: translateY(-2px);
    box-shadow: 0 0.4rem 2rem rgba(10, 22, 40, 0.08);
  }

  .mechanism-pillars__number {
    font-family: var(--tcc-font-heading);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--tcc-ink-soft);
    padding-bottom: var(--tcc-s-2, 16px);
    margin-bottom: var(--tcc-s-2, 16px);
    border-bottom: 1px solid var(--tcc-line);
  }

  .mechanism-pillars__pillar-title {
    font-family: var(--tcc-font-sans);
    font-weight: 700;
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--tcc-ink);
    margin: 0 0 var(--tcc-s-2, 16px);
    line-height: 1.2;
  }

  .mechanism-pillars__pillar-description {
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-body, 16px);
    color: var(--tcc-ink-soft);
    line-height: 1.65;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .mechanism-pillars__grid {
      grid-template-columns: 1fr;
      gap: var(--tcc-s-2, 16px);
    }

    .mechanism-pillars__heading {
      font-size: 24px;
    }

    .mechanism-pillars__pillar {
      padding: var(--tcc-s-3, 24px);
    }
  }
</style>

{% schema %}
{
  "name": "Mechanism Pillars",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One enzyme. Four mechanisms studied."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "Nattokinase is a serine protease isolated from natto, the traditional Japanese fermented soybean food. Across peer-reviewed and preprint research, four distinct activities have been observed — from fibrin breakdown to cardiovascular metric improvement."
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "pillar_number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "pillar_title",
          "label": "Pillar title",
          "default": "DEGRADE"
        },
        {
          "type": "textarea",
          "id": "pillar_description",
          "label": "Pillar description",
          "default": "Nattokinase has direct fibrin-degrading activity and inactivates PAI-1, releasing the brake on the body's natural clot-clearance pathway. Supports healthy fibrinolytic activity (Tanikawa 2022; Chen 2022 introduction)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mechanism Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "pillar_number": "01",
            "pillar_title": "DEGRADE",
            "pillar_description": "Nattokinase has direct fibrin-degrading activity and inactivates PAI-1, releasing the brake on the body's natural clot-clearance pathway. Supports healthy fibrinolytic activity (Tanikawa 2022; Chen 2022 introduction)."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "pillar_number": "02",
            "pillar_title": "DEGRADE SPIKE",
            "pillar_description": "In a 2022 in vitro study, nattokinase degraded the SARS-CoV-2 spike protein and its receptor-binding domain in a dose- and time-dependent manner — within 60–180 minutes (Tanikawa 2022, Molecules; laboratory study, not in vivo)."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "pillar_number": "03",
            "pillar_title": "CLEAR MICROCLOTS",
            "pillar_description": "Early research shows recombinant nattokinase degrades fibrin-amyloid microclots in vitro — the abnormal, fibrinolysis-resistant clots associated with post-viral conditions (Grixti, Pretorius & Kell 2024 preprint)."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "pillar_number": "04",
            "pillar_title": "PROTECT VASCULAR",
            "pillar_description": "In a 12-month trial of 1,062 adults at 10,800 FU/day, nattokinase was associated with carotid plaque reduction (–36%), arterial wall thinning (–22%), LDL down 18%, HDL up 16% (Chen 2022, Frontiers in Cardiovascular Medicine)."
          }
        }
      ]
    }
  ]
}
{% endschema %}
