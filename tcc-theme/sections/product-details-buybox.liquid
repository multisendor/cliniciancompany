<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var stickyBar = document.getElementById('sticky-atc-' + sectionId);
    var stickyBtn = document.getElementById('sticky-atc-btn-' + sectionId);
    var stickyPrice = document.getElementById('sticky-atc-price-' + sectionId);
    var stickyCompare = document.getElementById('sticky-atc-compare-' + sectionId);
    var section = document.querySelector('[data-section-type="product-details-buybox"]');
    var realBtn = document.querySelector('#product-form-buybox [name="add"]');

    if (!stickyBar || !realBtn || !section) return;

    // Mirror prices from real button — re-query live each tick so Kaching DOM replacement is handled
    function syncPrices() {
      var realPrice = section.querySelector('[data-btn-price]');
      var realCompare = section.querySelector('[data-btn-compare]');
      if (realPrice) stickyPrice.textContent = realPrice.textContent;
      if (realCompare) {
        stickyCompare.textContent = realCompare.textContent;
        stickyCompare.style.display = realCompare.style.display;
      }
    }
    syncPrices();
    setInterval(syncPrices, 300);

    // Delegate click: submit the form exactly as the real button would
    stickyBtn.addEventListener('click', function() {
      var nativeBtn = document.querySelector('#product-form-buybox [name="add"]');
      if (!nativeBtn) return;
      var form = nativeBtn.closest('form');
      if (form && form.requestSubmit) {
        form.requestSubmit(nativeBtn);
      } else {
        nativeBtn.click();
      }
    });

    // Show/hide: only when scrolled past (below) the real button — mobile only
    if (window.matchMedia('(max-width: 749px)').matches) {
      function updateStickyVisibility() {
        var scrolledPast = realBtn.getBoundingClientRect().bottom < 0;
        stickyBar.style.display = scrolledPast ? 'block' : 'none';
        stickyBar.setAttribute('aria-hidden', scrolledPast ? 'false' : 'true');
      }
      window.addEventListener('scroll', updateStickyVisibility, { passive: true });
      updateStickyVisibility();
    }
  })();
</script>

