<script>
  (function() {
    // Ships-by date: next business day
    var shipDateEl = document.getElementById('buybox-ship-date');
    if (shipDateEl) {
      var now = new Date();
      var day = now.getDay(); // 0=Sun,1=Mon,...,6=Sat
      var daysToAdd = 2;
      var shipDate = new Date(now);
      shipDate.setDate(now.getDate() + daysToAdd);
      var days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
      var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      shipDateEl.textContent = days[shipDate.getDay()] + ', ' + months[shipDate.getMonth()] + ' ' + shipDate.getDate();
    }
  })();
</script>

<script>
  (function() {
    var section = document.querySelector('[data-section-type="product-details-buybox"]');
    if (!section) return;

    var badgeMode = '{{ section.settings.badge_mode }}';
    var currentPriceEl = section.querySelector('[data-current-price]');
    var comparePriceEl = section.querySelector('[data-compare-price]');
    var saveAmountEl = section.querySelector('[data-save-amount]');
    var badgeWrapper = section.querySelector('[data-sale-badge-wrapper]');
    var btnPriceEl = section.querySelector('[data-btn-price]');
    var btnCompareEl = section.querySelector('[data-btn-compare]');
    var lastKachingPrice = null;
    var bogoLabelEl = section.querySelector('[data-bogo-label]');
    var bogoLabels = [
      '{{ section.settings.bogo_label_1 | escape }}',
      '{{ section.settings.bogo_label_2 | escape }}',
      '{{ section.settings.bogo_label_3 | escape }}'
    ];

    function parsePrice(str) {
      if (!str) return 0;
      return parseFloat(str.replace(/[^0-9.]/g, '')) || 0;
    }

    function formatPrice(num) {
      return '$' + num.toFixed(2);
    }

    function updatePriceDisplay(price, compare) {
      // Always update button prices regardless of whether price section is visible
      if (btnPriceEl) btnPriceEl.textContent = price || '';
      if (btnCompareEl) {
        btnCompareEl.textContent = compare || '';
        btnCompareEl.style.display = compare ? '' : 'none';
      }

      if (!currentPriceEl) return;
      currentPriceEl.textContent = price;

      if (comparePriceEl) {
        comparePriceEl.textContent = compare;
        comparePriceEl.style.display = compare ? '' : 'none';
      }

      if (saveAmountEl && compare) {
        var priceVal = parsePrice(price);
        var compareVal = parsePrice(compare);
        if (compareVal > 0 && priceVal < compareVal) {
          var diff = compareVal - priceVal;
          if (saveAmountEl) saveAmountEl.textContent = formatPrice(diff);
          if (badgeWrapper) badgeWrapper.style.display = 'flex';
        } else {
          if (badgeWrapper) badgeWrapper.style.display = 'none';
        }
      }
    }

    // Initial price
    var initialPrice = '{{ section_product.selected_or_first_available_variant.price | money }}';
    var initialCompare = '{{ section_product.selected_or_first_available_variant.compare_at_price | money }}';
    updatePriceDisplay(initialPrice, initialCompare);

    // Price update from Kaching event (event price is correct, event compare_at_price is not)
    document.addEventListener('kaching-bundles:price-updated', function(event) {
      if (!event.detail || !event.detail.price) return;
      function normalizePrice(val) {
        if (!val) return null;
        if (typeof val === 'number') return '$' + (val / 100).toFixed(2);
        return String(val).trim() || null;
      }
      var price = normalizePrice(event.detail.price);
      lastKachingPrice = price;
      if (btnPriceEl) btnPriceEl.textContent = price || '';
      if (currentPriceEl) currentPriceEl.textContent = price || '';
    });

    // Sync all prices directly from Kaching widget DOM via MutationObserver.
    // Reading from DOM is always correct regardless of event timing.
    function syncCompareFromKaching() {
      var selectedBar = document.querySelector('.kaching-bundles__bar--selected');
      if (!selectedBar) return;

      // Re-query btnPriceEl live — Kaching may replace the ATC button DOM after page load
      var liveBtnPriceEl = section.querySelector('[data-btn-price]') || btnPriceEl;

      // Current price: read directly from .kaching-bundles__bar-price in selected bar
      var barPriceEl = selectedBar.querySelector('.kaching-bundles__bar-price');
      var currentPrice = barPriceEl ? barPriceEl.textContent.trim() : null;
      if (currentPrice) {
        if (currentPriceEl) currentPriceEl.textContent = currentPrice;
        if (liveBtnPriceEl) liveBtnPriceEl.textContent = currentPrice;
      } else if (lastKachingPrice) {
        if (currentPriceEl) currentPriceEl.textContent = lastKachingPrice;
        if (liveBtnPriceEl) liveBtnPriceEl.textContent = lastKachingPrice;
      }

      // BOGO label: map bar index (excluding subscription bar which has no price)
      var allBars = Array.from(document.querySelectorAll('.kaching-bundles__bar')).filter(function(b) {
        return !!b.querySelector('.kaching-bundles__bar-price');
      });
      var barIndex = allBars.indexOf(selectedBar);
      if (bogoLabelEl && barIndex >= 0 && bogoLabels[barIndex]) {
        bogoLabelEl.textContent = bogoLabels[barIndex];
      }

      // Compare price: read from .kaching-bundles__bar-full-price
      var fullPriceEl = selectedBar.querySelector('.kaching-bundles__bar-full-price');
      var compare = fullPriceEl ? fullPriceEl.textContent.trim() : null;
      if (btnCompareEl) {
        btnCompareEl.textContent = compare || '';
        btnCompareEl.style.display = compare ? '' : 'none';
      }
      if (comparePriceEl) {
        comparePriceEl.textContent = compare || '';
        comparePriceEl.style.display = compare ? '' : 'none';
      }
      if (compare && liveBtnPriceEl) {
        var priceVal = parsePrice(liveBtnPriceEl.textContent);
        var compareVal = parsePrice(compare);
        if (compareVal > 0 && priceVal < compareVal) {
          if (saveAmountEl) saveAmountEl.textContent = formatPrice(compareVal - priceVal);
          if (badgeWrapper) badgeWrapper.style.display = 'flex';
        } else {
          if (badgeWrapper) badgeWrapper.style.display = 'none';
        }
      }
    }

    // Poll until Kaching renders its widget block, then observe any DOM change within it.
    // We watch the whole .kaching-bundles__block (not just .kaching-bundles__bars) because
    // the subscription card lives in a sibling branch — its toggle changes text content, not classes.
    (function waitForKaching() {
      var kachingBlock = document.querySelector('.kaching-bundles__block');
      if (kachingBlock) {
        var debounceTimer = null;
        var observer = new MutationObserver(function() {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(syncCompareFromKaching, 50);
        });
        observer.observe(kachingBlock, { subtree: true, attributes: true, childList: true, characterData: true });
        syncCompareFromKaching();
      } else {
        setTimeout(waitForKaching, 100);
      }
    })();
  })();
</script>

<script>
  (function() {
    var gallery = document.getElementById('BuyboxGallery-{{ section.id }}');
    if (!gallery) return;
    var thumbs = gallery.querySelectorAll('.product-media-gallery__thumb');
    var mainSlider = gallery.querySelector('#BuyboxMainSlider-{{ section.id }}');
    var slides = gallery.querySelectorAll('.product-media-gallery__slide');
    var prevBtn = gallery.querySelector('.product-media-gallery__arrow--prev');
    var nextBtn = gallery.querySelector('.product-media-gallery__arrow--next');
    var thumbContainer = gallery.querySelector('.product-media-gallery__thumbs');
    if (!mainSlider || slides.length === 0) return;
    var activeIndex = 0;
    function scrollThumbsIntoView(index) {
      if (!thumbContainer || !thumbs[index]) return;
      thumbContainer.scrollTo({
        left: thumbs[index].offsetLeft - (thumbContainer.offsetWidth / 2) + (thumbs[index].offsetWidth / 2),
        behavior: 'smooth'
      });
    }
    function goToIndex(index) {
      if (index < 0 || index >= slides.length) return;
      activeIndex = index;
      mainSlider.scrollTo({ left: slides[0].offsetWidth * activeIndex, behavior: 'smooth' });
      thumbs.forEach(function(t, i) { t.classList.toggle('product-media-gallery__thumb--active', i === activeIndex); });
      if (prevBtn) prevBtn.disabled = activeIndex === 0;
      if (nextBtn) nextBtn.disabled = activeIndex === slides.length - 1;
      scrollThumbsIntoView(activeIndex);
    }
    var isScrolling;
    mainSlider.addEventListener('scroll', function() {
      window.clearTimeout(isScrolling);
      isScrolling = setTimeout(function() {
        var newIndex = Math.round(mainSlider.scrollLeft / slides[0].offsetWidth);
        if (newIndex !== activeIndex) { goToIndex(newIndex); }
      }, 66);
    });
    thumbs.forEach(function(thumb, i) { thumb.addEventListener('click', function() { goToIndex(i); }); });
    if (prevBtn) prevBtn.addEventListener('click', function() { if (activeIndex > 0) goToIndex(activeIndex - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function() { if (activeIndex < slides.length - 1) goToIndex(activeIndex + 1); });
  })();
</script>

