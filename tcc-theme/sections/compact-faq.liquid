<div
  class="compact-faq tcc-section-padding"
  data-section-type="compact-faq"
  data-section-id="{{ section.id }}"
>
  <div class="tcc-page-width">
    <div class="compact-faq__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="compact-faq__eyebrow tcc-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="compact-faq__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="compact-faq__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="compact-faq__list">
        {%- for block in section.blocks -%}
          <details class="compact-faq__row" {{ block.shopify_attributes }}>
            <summary class="compact-faq__summary">
              <span class="compact-faq__question">{{ block.settings.question }}</span>
              <span class="compact-faq__chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </summary>
            <div class="compact-faq__answer">
              {{ block.settings.answer }}
            </div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .compact-faq {
    background: var(--tcc-bg);
    color: var(--tcc-ink);
  }

  .compact-faq__header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto var(--tcc-s-5, 40px);
  }

  .compact-faq__eyebrow {
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-eyebrow, 11px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--tcc-ink-soft);
    margin: 0 0 var(--tcc-s-2, 16px);
  }

  .compact-faq__heading {
    font-family: var(--tcc-font-heading);
    font-weight: 500;
    font-size: var(--tcc-fs-h2, clamp(24px, 3vw, 32px));
    color: var(--tcc-ink);
    margin: 0 0 var(--tcc-s-2, 16px);
    line-height: 1.2;
  }

  .compact-faq__intro {
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-body, 16px);
    color: var(--tcc-ink-soft);
    line-height: 1.65;
    margin: 0;
  }

  .compact-faq__list {
    max-width: 820px;
    margin: 0 auto;
    border-top: 1px solid var(--tcc-line);
  }

  .compact-faq__row {
    border-bottom: 1px solid var(--tcc-line);
  }

  .compact-faq__summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--tcc-s-3, 24px);
    padding: var(--tcc-s-3, 24px) 0;
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-body, 16px);
    font-weight: 500;
    color: var(--tcc-ink);
    line-height: 1.4;
    transition: opacity 0.15s ease;
  }

  .compact-faq__summary:hover {
    opacity: 0.75;
  }

  .compact-faq__summary::-webkit-details-marker {
    display: none;
  }

  .compact-faq__question {
    flex: 1;
  }

  .compact-faq__chevron {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--tcc-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .compact-faq__chevron svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .compact-faq__row[open] .compact-faq__chevron {
    transform: rotate(180deg);
  }

  .compact-faq__answer {
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-body, 16px);
    color: var(--tcc-ink-soft);
    line-height: 1.65;
    padding: 0 0 var(--tcc-s-3, 24px);
    max-width: 720px;
  }

  .compact-faq__answer p {
    margin: 0 0 var(--tcc-s-2, 16px);
  }

  .compact-faq__answer p:last-child {
    margin-bottom: 0;
  }

  .compact-faq__answer strong {
    color: var(--tcc-ink);
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .compact-faq__heading {
      font-size: 22px;
    }
    .compact-faq__summary {
      font-size: 15px;
      padding: var(--tcc-s-2, 16px) 0;
    }
    .compact-faq__answer {
      font-size: 15px;
      padding-bottom: var(--tcc-s-2, 16px);
    }
  }
</style>

{% schema %}
{
  "name": "Compact FAQ",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Before you decide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quick answers to the questions buyers ask first"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro paragraph (optional)",
      "default": "If you're considering Spike Detox, these are the questions other buyers send us most often. The deeper FAQ at the bottom of this page covers the science, dosing math, drug-interaction detail, and disclaimers."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ row",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question placeholder"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer placeholder.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Compact FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Is this just nattokinase, or is it a blend?",
            "answer": "<p>Just nattokinase. One ingredient, 4,000 FU per capsule. We do not hide the dose inside a proprietary blend, and we do not bundle in K2 or other co-factors that complicate it for blood-thinner users.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Why 4,000 FU per capsule and not more?",
            "answer": "<p>4,000 FU is the highest single-capsule dose that lets you stack to whatever range your protocol calls for. The largest peer-reviewed trial (Chen 2022, n=1,062, 12 months) identified 6,000&ndash;12,000 FU/day as clinically active. One, two, or three capsules &mdash; you decide with your clinician.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "I'm on a blood thinner. Can I take this?",
            "answer": "<p><strong>Talk to your prescribing physician first.</strong> Nattokinase has fibrinolytic activity. It can interact with anticoagulants like Eliquis, Xarelto, warfarin, and aspirin. It is not a substitute for your prescribed therapy. We address this in detail in the deeper FAQ.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "When will I notice anything?",
            "answer": "<p>Honest answer: it varies. Chen 2022 measured cardiovascular markers (lipids, carotid plaque) starting around month 3, with the strongest signals between months 6 and 12. Nattokinase is not a fast-acting drug.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Is it third-party tested?",
            "answer": "<p>Yes &mdash; every batch. Identity, FU activity, heavy metals, microbials. COA published per lot.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
