<div
  data-section-type="bottom-faq"
  class="bottom-faq tcc-section-padding"
>
  <div class="bottom-faq__inner tcc-page-width">

    <!-- Heading (centered, Resilia-style) -->
    {%- if section.settings.heading != blank -%}
      <h2 class="bottom-faq__heading tcc-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="bottom-faq__description tcc-body">{{ section.settings.description }}</div>
    {%- endif -%}

    <!-- Card-style accordion -->
    {%- if section.blocks.size > 0 -%}
      <div class="bottom-faq__list">
        {%- for block in section.blocks -%}
          <details class="bottom-faq__item" {{ block.shopify_attributes }}>
            <summary class="bottom-faq__summary tcc-heading">
              <span class="bottom-faq__question">{{ block.settings.title }}</span>
              <svg class="bottom-faq__chevron" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="bottom-faq__content tcc-body">
              {{ block.settings.content }}
            </div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Bottom CTA pill + guarantee row (matches Resilia) -->
    {%- if section.settings.show_cta -%}
      <div class="bottom-faq__cta-wrap">
        <a
          class="bottom-faq__cta"
          href="{{ section.settings.cta_link | default: '/products/spike-detox' }}"
          {%- if section.settings.cta_bg_color != blank -%}style="--cta-bold-bg: {{ section.settings.cta_bg_color }};"{%- endif -%}
        >
          {{ section.settings.cta_text | default: 'BUY NOW & SAVE' }}
        </a>
        {%- if section.settings.guarantee_text != blank -%}
          <p class="bottom-faq__guarantee">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"/>
              <polyline points="9,12 11,14 15,10"/>
            </svg>
            <span>{{ section.settings.guarantee_text }}</span>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  /* Resilia-faithful bottom FAQ: cream section bg, white CARD per question,
     centered heading, BUY NOW pill + guarantee row at the bottom. */
  .bottom-faq {
    background-color: #eef0e8;
  }

  .bottom-faq__inner {
    max-width: 1100px;
  }

  .bottom-faq__heading {
    font-size: 40px;
    line-height: 1.15;
    font-weight: 700;
    margin: 0 0 40px;
    color: #0a1628;
    text-align: center;
    letter-spacing: normal;
  }

  .bottom-faq__description {
    font-size: 16px;
    line-height: 1.6;
    color: #4a4a4a;
    text-align: center;
    max-width: 720px;
    margin: 0 auto 40px;
  }
  .bottom-faq__description p { margin: 0; }

  /* Card list */
  .bottom-faq__list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .bottom-faq__item {
    background: #ffffff;
    border: 1px solid #d6d6d6;
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }
  .bottom-faq__item[open] {
    border-color: #b8b8b8;
  }

  .bottom-faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 24px;
    cursor: pointer;
    font-size: 18px;
    line-height: 1.35;
    font-weight: 700;
    list-style: none;
    user-select: none;
    gap: 1.5rem;
    color: #0a1628;
  }

  .bottom-faq__summary::-webkit-details-marker { display: none; }
  .bottom-faq__summary::marker { display: none; content: ''; }

  .bottom-faq__question { flex: 1; }

  .bottom-faq__chevron {
    flex-shrink: 0;
    color: #0a1628;
    opacity: 0.6;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .bottom-faq__summary:hover .bottom-faq__chevron { opacity: 0.9; }
  .bottom-faq__item[open] .bottom-faq__chevron { transform: rotate(180deg); }

  .bottom-faq__content {
    padding: 0 24px 22px;
    font-size: 16px;
    line-height: 1.55;
    color: #4a4a4a;
  }
  .bottom-faq__content p { margin: 0 0 0.75rem 0; }
  .bottom-faq__content p:last-child { margin-bottom: 0; }

  /* Bottom CTA cluster */
  .bottom-faq__cta-wrap {
    margin: 40px auto 0;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .bottom-faq__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: var(--cta-bold-bg, var(--tcc-cta-accent, #1e40af));
    color: #f6f9fe;
    text-decoration: none;
    border-radius: 30px;
    padding: 18px 24px;
    font-size: 18px;
    line-height: 27.54px;
    font-weight: 700;
    letter-spacing: 0.36px;
    text-transform: uppercase;
    transition: filter 0.2s ease;
  }
  .bottom-faq__cta:hover { filter: brightness(0.88); color: #f6f9fe; }

  .bottom-faq__guarantee {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #0a1628;
    margin: 0;
  }
  .bottom-faq__guarantee svg { color: #0a1628; }

  @media screen and (max-width: 749px) {
    .bottom-faq__heading {
      font-size: 28px;
      margin-bottom: 28px;
    }
    .bottom-faq__description {
      font-size: 15px;
      margin-bottom: 28px;
    }
    .bottom-faq__summary {
      padding: 18px 18px;
      font-size: 16px;
      gap: 1rem;
    }
    .bottom-faq__content {
      padding: 0 18px 18px;
      font-size: 15px;
    }
    .bottom-faq__cta {
      font-size: 16px;
      line-height: 24.48px;
      letter-spacing: 0.32px;
      padding: 16px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Bottom FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Honest answers about nattokinase"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Transparency matters when it comes to cardiovascular supplements. Below: dose justification, safety with blood-thinners, K2 framing, what happens when you stop, and links to the actual peer-reviewed studies.</p>"
    },
    { "type": "header", "content": "Bottom CTA (Resilia-style)" },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show BUY NOW pill + guarantee row at the bottom",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "BUY NOW & SAVE"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "CTA background color (leave blank to inherit theme accent)",
      "default": ""
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "30-Day Money Back Guarantee"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Answer",
          "default": "<p>Answer goes here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 15,
  "presets": [
    {
      "name": "Bottom FAQ",
      "blocks": [
        { "type": "faq", "settings": { "title": "What is nattokinase?", "content": "<p>Nattokinase is a serine-protease enzyme extracted from natto, a traditional Japanese fermented soybean food. Discovered in Tokyo in 1980 by Dr. Hiroyuki Sumi, it's been studied for over 40 years for its activity on fibrin.</p>" } },
        { "type": "faq", "settings": { "title": "Why 4,000 FU per capsule? How many should I take?", "content": "<p>The largest clinical study to date — Chen et al. (2022, n=1,062, 12 months) — concludes the clinically active range is <strong>6,000–12,000 FU per day</strong>. We picked 4,000 FU per capsule so you can dose to your protocol with your clinician: 1 capsule = 4,000 FU; 2 capsules = ~8,000 FU; 3 capsules = ~12,000 FU. Per-capsule is per-protocol.</p>" } },
        { "type": "faq", "settings": { "title": "Is it safe with Eliquis, Xarelto, warfarin, or aspirin?", "content": "<p><strong>Talk to your prescribing physician before starting.</strong> Nattokinase has fibrinolytic activity, so the conversation matters. We removed K2 specifically because it interacts with vitamin-K-antagonists like warfarin. Chen 2022 reported no adverse events at 10,800 FU/day for 12 months across 1,062 adults.</p>" } },
        { "type": "faq", "settings": { "title": "Why did you remove K2? Can I get it from you?", "content": "<p>K2 (menaquinone-7) can interact with vitamin-K-antagonist blood thinners like warfarin. We removed it for compatibility — and we're honest: Chen 2022 actually shows K2 was synergistic with nattokinase for lipid endpoints. If you don't take vitamin-K-antagonists, we sell K2 MK-7 separately ($14 standalone, $9 bundled).</p>" } },
        { "type": "faq", "settings": { "title": "How long until I notice a difference?", "content": "<p>It varies, and no one can promise an outcome. Chen 2022 measured cardiovascular endpoints at 12 months. We don't make week-by-week promises about how you'll feel.</p>" } },
        { "type": "faq", "settings": { "title": "When should I take it?", "content": "<p>On an empty stomach, ideally 30 minutes before a meal or before bed. Food can reduce enzyme activity. Many split into morning + evening doses if taking 2–3 capsules.</p>" } },
        { "type": "faq", "settings": { "title": "What happens if I stop taking it?", "content": "<p>Many people use Spike Detox as ongoing cardiovascular support, similar to a daily vitamin. Others use it for time-limited protocols. Talk to your healthcare provider about what makes sense for your situation.</p>" } },
        { "type": "faq", "settings": { "title": "Is this third-party tested?", "content": "<p>Yes — every batch is independently tested for FU activity, heavy metals, microbials, and label accuracy. The Certificate of Analysis for your specific lot is published online; the lot number is printed on every bottle.</p>" } },
        { "type": "faq", "settings": { "title": "Required disclaimers", "content": "<p><em>These statements have not been evaluated by the FDA. This product is not intended to diagnose, treat, cure, or prevent any disease.</em></p><p><em>Consult your healthcare provider before use, especially if you take blood-thinning medication, are pregnant or nursing, or have a bleeding disorder.</em></p>" } }
      ]
    }
  ]
}
{% endschema %}
