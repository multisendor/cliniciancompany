<div
  data-section-type="bottom-faq"
  class="bottom-faq tcc-section-padding"
>
  <div class="bottom-faq__inner tcc-page-width">
    <div class="bottom-faq__layout">
      
      <!-- Left Column: Heading & Text -->
      <div class="bottom-faq__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="bottom-faq__heading tcc-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="bottom-faq__description tcc-body">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>

      <!-- Right Column: Accordion -->
      {%- if section.blocks.size > 0 -%}
        <div class="bottom-faq__list">
          {%- for block in section.blocks -%}
            <details class="bottom-faq__item" {{ block.shopify_attributes }}>
              <summary class="bottom-faq__summary tcc-heading">
                <span>{{ block.settings.title }}</span>
                <span class="bottom-faq__icon-plus">+</span>
                <span class="bottom-faq__icon-minus">−</span>
              </summary>
              <div class="bottom-faq__content tcc-body">
                {{ block.settings.content }}
              </div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

<style>
  .bottom-faq {
    background-color: var(--tcc-bg);
  }

  .bottom-faq__layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: start;
  }

  .bottom-faq__header {
    position: sticky;
    top: 2rem;
  }

  .bottom-faq__heading {
    font-size: 31.2px;
    line-height: 1.2;
    font-weight: 500;
    margin: 0 0 1.5rem 0;
    color: var(--tcc-ink);
    text-align: left;
  }

  .bottom-faq__description {
    font-size: 15.2px;
    line-height: 1.6;
    color: var(--tcc-ink);
    opacity: 0.7;
  }

  .bottom-faq__description p {
    margin: 0;
  }

  .bottom-faq__description strong {
    color: var(--tcc-ink);
    font-weight: 500;
  }

  /* Accordion List */
  .bottom-faq__list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .bottom-faq__item {
    border-bottom: 1px solid var(--tcc-line);
  }

  .bottom-faq__item:first-child {
    border-top: 1px solid var(--tcc-line);
  }

  .bottom-faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0;
    cursor: pointer;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 500;
    list-style: none;
    user-select: none;
    gap: 2rem;
    color: var(--tcc-ink);
  }

  .bottom-faq__summary::-webkit-details-marker {
    display: none;
  }

  .bottom-faq__summary::marker {
    display: none;
    content: '';
  }

  .bottom-faq__icon-plus,
  .bottom-faq__icon-minus {
    font-size: 24px;
    line-height: 1;
    color: var(--tcc-ink);
    opacity: 0.4;
    flex-shrink: 0;
    font-family: Arial, sans-serif;
    font-weight: 300;
  }

  .bottom-faq__icon-minus {
    display: none;
  }

  .bottom-faq__item[open] .bottom-faq__icon-plus {
    display: none;
  }

  .bottom-faq__item[open] .bottom-faq__icon-minus {
    display: block;
  }

  .bottom-faq__content {
    padding: 0 0 1.5rem 0;
    font-size: 15.2px;
    line-height: 1.7;
    color: var(--tcc-ink);
    opacity: 0.8;
  }

  @media screen and (max-width: 1024px) {
    .bottom-faq__layout {
      gap: 2rem;
    }
  }

  @media screen and (max-width: 749px) {
    .bottom-faq__layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .bottom-faq__header {
      position: static;
    }

    .bottom-faq__heading {
      font-size: 28px;
      margin-bottom: 1rem;
    }

    .bottom-faq__summary {
      padding: 1.25rem 0;
      font-size: 15px;
    }

    .bottom-faq__content {
      font-size: 14.5px;
    }
  }
</style>

{% schema %}
{
  "name": "Bottom FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Honest answers about nattokinase"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Transparency matters when it comes to cardiovascular supplements. Below: dose justification, safety with blood-thinners, K2 framing, what happens when you stop, and links to the actual peer-reviewed studies.</p>"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Answer",
          "default": "<p>Answer goes here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 15,
  "presets": [
    {
      "name": "Bottom FAQ",
      "blocks": [
        { "type": "faq", "settings": { "title": "What is nattokinase?", "content": "<p>Nattokinase is a serine-protease enzyme extracted from natto, a traditional Japanese fermented soybean food. Discovered in Tokyo in 1980 by Dr. Hiroyuki Sumi, it's been studied for over 40 years for its activity on fibrin.</p>" } },
        { "type": "faq", "settings": { "title": "Why 4,000 FU per capsule? How many should I take?", "content": "<p>The largest clinical study to date — Chen et al. (2022, n=1,062, 12 months) — concludes the clinically active range is <strong>6,000–12,000 FU per day</strong>. We picked 4,000 FU per capsule so you can dose to your protocol with your clinician: 1 capsule = 4,000 FU; 2 capsules = ~8,000 FU; 3 capsules = ~12,000 FU. Per-capsule is per-protocol.</p>" } },
        { "type": "faq", "settings": { "title": "Is it safe with Eliquis, Xarelto, warfarin, or aspirin?", "content": "<p><strong>Talk to your prescribing physician before starting.</strong> Nattokinase has fibrinolytic activity, so the conversation matters. We removed K2 specifically because it interacts with vitamin-K-antagonists like warfarin. Chen 2022 reported no adverse events at 10,800 FU/day for 12 months across 1,062 adults.</p>" } },
        { "type": "faq", "settings": { "title": "Why did you remove K2? Can I get it from you?", "content": "<p>K2 (menaquinone-7) can interact with vitamin-K-antagonist blood thinners like warfarin. We removed it for compatibility — and we're honest: Chen 2022 actually shows K2 was synergistic with nattokinase for lipid endpoints. If you don't take vitamin-K-antagonists, we sell K2 MK-7 separately ($14 standalone, $9 bundled).</p>" } },
        { "type": "faq", "settings": { "title": "How long until I notice a difference?", "content": "<p>It varies, and no one can promise an outcome. Chen 2022 measured cardiovascular endpoints at 12 months. We don't make week-by-week promises about how you'll feel.</p>" } },
        { "type": "faq", "settings": { "title": "When should I take it?", "content": "<p>On an empty stomach, ideally 30 minutes before a meal or before bed. Food can reduce enzyme activity. Many split into morning + evening doses if taking 2–3 capsules.</p>" } },
        { "type": "faq", "settings": { "title": "What happens if I stop taking it?", "content": "<p>Many people use Spike Detox as ongoing cardiovascular support, similar to a daily vitamin. Others use it for time-limited protocols. Talk to your healthcare provider about what makes sense for your situation.</p>" } },
        { "type": "faq", "settings": { "title": "Is this third-party tested?", "content": "<p>Yes — every batch is independently tested for FU activity, heavy metals, microbials, and label accuracy. The Certificate of Analysis for your specific lot is published online; the lot number is printed on every bottle.</p>" } },
        { "type": "faq", "settings": { "title": "Required disclaimers", "content": "<p><em>These statements have not been evaluated by the FDA. This product is not intended to diagnose, treat, cure, or prevent any disease.</em></p><p><em>Consult your healthcare provider before use, especially if you take blood-thinning medication, are pregnant or nursing, or have a bleeding disorder.</em></p>" } }
      ]
    }
  ]
}
{% endschema %}
