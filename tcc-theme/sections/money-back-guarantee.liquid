<style>
  .mbg-section {
    background: #ffffff;
    padding: var(--tcc-s-3, 24px) var(--tcc-s-3, 24px);
  }

  .mbg-container {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .mbg-badge-wrapper {
    margin-bottom: var(--tcc-s-4, 32px);
  }

  .mbg-badge {
    width: 130px;
    height: 130px;
    position: relative;
    display: inline-block;
  }

  .mbg-badge svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .mbg-badge-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 2;
  }

  .mbg-badge-number {
    font-size: 48px;
    font-weight: 700;
    color: #fff;
    line-height: 1;
    margin: 0;
    font-family: var(--tcc-font-sans);
  }

  .mbg-badge-text {
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    line-height: 1;
    margin: 6px 0 0 0;
    letter-spacing: 1px;
    font-family: var(--tcc-font-sans);
  }

  .mbg-subtitle {
    font-size: var(--tcc-fs-eyebrow, 11px);
    font-weight: 700;
    color: var(--tcc-ink);
    letter-spacing: 2px;
    margin: 0 0 12px 0;
    text-transform: uppercase;
    font-family: var(--tcc-font-sans);
  }

  .mbg-title {
    font-size: var(--tcc-fs-h2, clamp(24px, 3vw, 32px));
    font-weight: 500;
    color: #000;
    margin: 0 0 12px 0;
    line-height: 1.2;
    font-family: var(--tcc-font-sans);
  }

  .mbg-description {
    font-size: var(--tcc-fs-small, 13px);
    color: #666;
    line-height: 1.7;
    margin: 0 0 24px 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    font-family: var(--tcc-font-sans);
  }

  .mbg-button {
    display: block;
    width: 100%;
    max-width: 320px;
    margin: 0 auto 40px;
    padding: 14px 32px;
    background: var(--tcc-ink);
    color: #fff;
    font-size: var(--tcc-fs-body, 16px);
    font-weight: 500;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    font-family: var(--tcc-font-sans);
    letter-spacing: 0.04em;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .mbg-button:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .mbg-image-wrapper {
    max-width: 400px;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 12px;
  }

  .mbg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 12px;
  }

  @media screen and (min-width: 750px) {
    .mbg-section {
      padding: var(--tcc-s-3, 24px) var(--tcc-s-3, 24px);
    }

    .mbg-badge {
      width: 150px;
      height: 150px;
    }

    .mbg-badge-number {
      font-size: 58px;
    }

    .mbg-badge-text {
      font-size: 16px;
      margin: 8px 0 0 0;
    }

    .mbg-title {
      font-size: clamp(28px, 3.5vw, 36px);
    }

    .mbg-description {
      font-size: 15px;
      max-width: 650px;
    }

    .mbg-button {
      max-width: 350px;
      padding: 15px 40px;
    }
  }

  @media screen and (max-width: 749px) {
    .mbg-button {
      max-width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Money Back Guarantee",
  "settings": [
    {
      "type": "text",
      "id": "days",
      "label": "Days Number",
      "default": "60"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Our Promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "60-Day Money-Back Guarantee"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Try {{ settings.brand_name }} for 60 days. If you're not satisfied for any reason — even if the bottle is empty — email us for a full refund. No questions asked."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add To Cart"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "external_image_url",
      "label": "External Image URL"
    }
  ],
  "presets": [
    {
      "name": "Money Back Guarantee"
    }
  ]
}
{% endschema %}
