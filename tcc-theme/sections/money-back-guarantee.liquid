    </div>

    <!-- Header -->
    <div class="mbg-header">
      <p class="mbg-subtitle">{{ section.settings.subtitle }}</p>
      <h2 class="mbg-title">{{ section.settings.heading }}</h2>
      <p class="mbg-description">{{ section.settings.description }}</p>
    </div>


  </div>
