{%- assign rows = section.blocks | where: "type", "row" -%}

<div
  data-section-type="comparison-vs"
  data-section-id="{{ section.id }}"
  class="comparison-vs tcc-section-padding"
>
  <div class="comparison-vs__inner tcc-page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="comparison-vs__heading tcc-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="comparison-vs__table" role="table" aria-label="{{ section.settings.heading | escape }}">

      {%- comment -%} VS badge — floats above the center column at the top {%- endcomment -%}
      <div class="comparison-vs__vs-badge" aria-hidden="true">
        <span class="comparison-vs__vs-text">VS</span>
      </div>

      {%- comment -%} TABLE HEADER ROW: brand image | subhead | competitor image {%- endcomment -%}
      <div class="comparison-vs__head" role="row">

        <div class="comparison-vs__col comparison-vs__col--brand comparison-vs__head-cell" role="cell">
          {%- if section.settings.brand_image_url != blank -%}
            <img
              class="comparison-vs__product-img"
              src="{{ section.settings.brand_image_url }}"
              alt="{{ section.settings.brand_name | escape }}"
              loading="lazy"
              width="180"
              height="auto"
            >
          {%- endif -%}
          <div class="comparison-vs__brand-label">{{ section.settings.brand_name | default: 'Spike Detox' }}</div>
        </div>

        <div class="comparison-vs__col comparison-vs__col--center comparison-vs__head-cell" role="cell">
          <div class="comparison-vs__subhead">{{ section.settings.subhead | default: 'Which delivers more real benefits?' }}</div>
        </div>

        <div class="comparison-vs__col comparison-vs__col--competitor comparison-vs__head-cell" role="cell">
          {%- if section.settings.competitor_image_url != blank -%}
            <img
              class="comparison-vs__product-img comparison-vs__product-img--competitor"
              src="{{ section.settings.competitor_image_url }}"
              alt="{{ section.settings.competitor_name | escape }}"
              loading="lazy"
              width="180"
              height="auto"
            >
          {%- endif -%}
          <div class="comparison-vs__brand-label comparison-vs__brand-label--competitor">{{ section.settings.competitor_name | default: 'Typical Nattokinase Supplements' }}</div>
        </div>

      </div>

      {%- comment -%} FEATURE ROWS {%- endcomment -%}
      {%- for block in rows -%}
        <div class="comparison-vs__row" role="row" {{ block.shopify_attributes }}>

          <div class="comparison-vs__col comparison-vs__col--brand comparison-vs__cell" role="cell">
            {%- if block.settings.brand_check == 'yes' -%}
              <span class="comparison-vs__icon comparison-vs__icon--check" aria-label="Yes">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {%- else -%}
              <span class="comparison-vs__icon comparison-vs__icon--x" aria-label="No">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round"/>
                </svg>
              </span>
            {%- endif -%}
          </div>

          <div class="comparison-vs__col comparison-vs__col--center comparison-vs__cell comparison-vs__cell--label" role="cell">
            <span class="comparison-vs__feature">{{ block.settings.feature_label }}</span>
          </div>

          <div class="comparison-vs__col comparison-vs__col--competitor comparison-vs__cell" role="cell">
            {%- if block.settings.competitor_check == 'yes' -%}
              <span class="comparison-vs__icon comparison-vs__icon--check" aria-label="Yes">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {%- else -%}
              <span class="comparison-vs__icon comparison-vs__icon--x" aria-label="No">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round"/>
                </svg>
              </span>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}

    </div>

    {%- if section.settings.show_cta -%}
      <div class="comparison-vs__cta-wrap">
        <a
          class="comparison-vs__cta"
          href="{{ section.settings.cta_link | default: '/products/spike-detox' }}"
        >
          {{ section.settings.cta_text | default: 'BUY NOW & SAVE' }}
        </a>
        {%- if section.settings.guarantee_text != blank -%}
          <p class="comparison-vs__guarantee">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"/>
              <polyline points="9,12 11,14 15,10"/>
            </svg>
            <span>{{ section.settings.guarantee_text }}</span>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  /* Resilia-faithful 3-column comparison: cream section bg,
     dark accent center column (overhangs top with VS badge),
     check (accent) / X (red) icons on side columns, hairline row dividers. */
  .comparison-vs {
    background-color: var(--tcc-section-muted, #EEF1F8);
  }

  .comparison-vs__inner {
    max-width: 1100px;
  }

  .comparison-vs__heading {
    font-size: 40px;
    line-height: 1.15;
    font-weight: 700;
    color: #0a1628;
    text-align: center;
    margin: 0 auto 56px;
    max-width: 880px;
    letter-spacing: normal;
  }

  /* Table — bordered container with rounded corners. The center column
     overhangs the top of the table by ~40px and carries the VS badge. */
  .comparison-vs__table {
    position: relative;
    max-width: 1000px;
    margin: 80px auto 0;
    border: 2px solid var(--tcc-cta-accent, #1e40af);
    border-radius: 10px;
    background-color: transparent;
    overflow: visible;
  }

  /* Each "row" is a 3-col grid: 30/40/30 (matches Resilia 298/398/298) */
  .comparison-vs__head,
  .comparison-vs__row {
    display: grid;
    grid-template-columns: 30% 40% 30%;
    align-items: stretch;
  }

  /* HEADER ROW — taller; center column overhangs the table top */
  .comparison-vs__head {
    position: relative;
  }

  .comparison-vs__head-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 24px 16px 28px;
    text-align: center;
  }

  /* Side header cells: cream/transparent — give them height so the
     center column "overhang" looks intentional */
  .comparison-vs__head-cell.comparison-vs__col--brand,
  .comparison-vs__head-cell.comparison-vs__col--competitor {
    min-height: 220px;
    background-color: transparent;
  }

  /* Center header cell: dark accent, overhangs the top of the table */
  .comparison-vs__head-cell.comparison-vs__col--center {
    background-color: var(--tcc-cta-accent, #1e40af);
    color: #ffffff;
    border-radius: 10px 10px 0 0;
    margin-top: -40px; /* overhang */
    padding-top: 80px;
    min-height: 260px;
    justify-content: center;
  }

  .comparison-vs__product-img {
    display: block;
    max-width: 100%;
    width: 180px;
    height: auto;
    margin: 0 auto 12px;
    object-fit: contain;
  }

  .comparison-vs__product-img--competitor {
    width: 130px;
  }

  .comparison-vs__brand-label {
    font-family: var(--tcc-font-sans);
    font-size: 22px;
    line-height: 1.2;
    font-weight: 600;
    color: var(--tcc-cta-accent, #1e40af);
  }

  .comparison-vs__brand-label--competitor {
    color: #0a1628;
    opacity: 0.85;
  }

  .comparison-vs__subhead {
    font-family: var(--tcc-font-sans);
    font-size: 24px;
    line-height: 1.25;
    font-weight: 700;
    color: #ffffff;
    text-align: center;
    max-width: 340px;
    margin: 0 auto;
  }

  /* VS BADGE — white circle floating above the center column top */
  .comparison-vs__vs-badge {
    position: absolute;
    top: -68px;
    left: 50%;
    transform: translateX(-50%);
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 2px solid var(--tcc-cta-accent, #1e40af);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 18px rgba(10, 22, 40, 0.12);
    z-index: 5;
  }

  .comparison-vs__vs-text {
    font-family: var(--tcc-font-sans);
    font-weight: 700;
    font-size: 22px;
    color: var(--tcc-cta-accent, #1e40af);
    letter-spacing: 0.02em;
  }

  /* FEATURE ROWS — hairline dividers run across all 3 columns;
     center column keeps its dark bg without inner dividers */
  .comparison-vs__row {
    border-top: 1px solid rgba(10, 22, 40, 0.12);
  }

  .comparison-vs__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 22px 16px;
    min-height: 78px;
    text-align: center;
  }

  .comparison-vs__col--center.comparison-vs__cell {
    background-color: var(--tcc-cta-accent, #1e40af);
    color: #ffffff;
  }

  .comparison-vs__feature {
    font-family: var(--tcc-font-sans);
    font-size: 17px;
    line-height: 1.35;
    font-weight: 500;
    color: #ffffff;
  }

  /* ICONS — circle with white check or X */
  .comparison-vs__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    box-shadow: 0 2px 6px rgba(10, 22, 40, 0.18);
  }

  .comparison-vs__icon--check {
    background-color: var(--tcc-cta-accent, #1e40af);
  }

  .comparison-vs__icon--x {
    background-color: #dc2626;
  }

  /* CTA + GUARANTEE — same pattern as bottom-faq */
  .comparison-vs__cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin: 56px auto 0;
  }

  .comparison-vs__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--tcc-cta-accent, #1e40af);
    color: #ffffff !important;
    text-decoration: none;
    font-family: var(--tcc-font-sans);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 18px 56px;
    border-radius: 999px;
    transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
    box-shadow: 0 6px 18px rgba(10, 22, 40, 0.12);
  }

  .comparison-vs__cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
    box-shadow: 0 10px 24px rgba(10, 22, 40, 0.18);
  }

  .comparison-vs__guarantee {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-family: var(--tcc-font-sans);
    font-size: 14px;
    font-weight: 500;
    color: #0a1628;
  }

  .comparison-vs__guarantee svg {
    color: var(--tcc-cta-accent, #1e40af);
    flex: 0 0 auto;
  }

  /* ----- Mobile (<750px) ----- */
  @media screen and (max-width: 749px) {
    .comparison-vs__heading {
      font-size: 28px;
      line-height: 1.2;
      margin-bottom: 40px;
      max-width: 100%;
    }

    .comparison-vs__inner {
      padding-left: 12px;
      padding-right: 12px;
    }

    .comparison-vs__table {
      margin-top: 60px;
      border-width: 2px;
    }

    .comparison-vs__head,
    .comparison-vs__row {
      grid-template-columns: 22% 56% 22%;
    }

    .comparison-vs__head-cell.comparison-vs__col--brand,
    .comparison-vs__head-cell.comparison-vs__col--competitor {
      min-height: 140px;
      padding: 12px 4px 14px;
    }

    .comparison-vs__head-cell.comparison-vs__col--center {
      margin-top: -28px;
      padding: 50px 12px 18px;
      min-height: 168px;
    }

    .comparison-vs__product-img {
      width: 78px;
    }
    .comparison-vs__product-img--competitor {
      width: 60px;
    }

    .comparison-vs__brand-label {
      font-size: 13px;
      font-weight: 600;
    }

    .comparison-vs__subhead {
      font-size: 15px;
      line-height: 1.3;
      max-width: 220px;
    }

    .comparison-vs__vs-badge {
      width: 52px;
      height: 52px;
      top: -48px;
    }
    .comparison-vs__vs-text {
      font-size: 16px;
    }

    .comparison-vs__cell {
      padding: 14px 6px;
      min-height: 64px;
    }

    .comparison-vs__feature {
      font-size: 13px;
      line-height: 1.3;
      font-weight: 500;
    }

    .comparison-vs__icon {
      width: 26px;
      height: 26px;
    }
    .comparison-vs__icon svg {
      width: 16px;
      height: 16px;
    }

    .comparison-vs__cta {
      width: 100%;
      max-width: 360px;
      padding: 16px 24px;
      font-size: 15px;
    }
  }
</style>

{% schema %}
{
  "name": "Comparison VS",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Spike Detox Outperforms Typical Nattokinase Supplements"
    },
    {
      "type": "header",
      "content": "Brand (left) column"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand label",
      "default": "Spike Detox"
    },
    {
      "type": "text",
      "id": "brand_image_url",
      "label": "Brand product image URL (external CDN)",
      "default": "https://www.twc.health/cdn/shop/files/SIG_UltSpike_Thumbnail.png?v=1773419148&width=400"
    },
    {
      "type": "header",
      "content": "Competitor (right) column"
    },
    {
      "type": "text",
      "id": "competitor_name",
      "label": "Competitor label",
      "default": "Typical Nattokinase Supplements"
    },
    {
      "type": "text",
      "id": "competitor_image_url",
      "label": "Competitor product image URL",
      "default": "https://cdn.shopify.com/s/files/1/0610/8862/8312/files/typical-bottle.png"
    },
    {
      "type": "header",
      "content": "Center (dark) column"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead (center top)",
      "default": "Which delivers more real benefits?"
    },
    {
      "type": "header",
      "content": "CTA + Guarantee"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show CTA + guarantee row",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "BUY NOW & SAVE"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "60-day money-back guarantee"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Feature row",
      "settings": [
        {
          "type": "text",
          "id": "feature_label",
          "label": "Feature label (center)",
          "default": "Feature"
        },
        {
          "type": "select",
          "id": "brand_check",
          "label": "Brand (left)",
          "default": "yes",
          "options": [
            { "value": "yes", "label": "Check (yes)" },
            { "value": "no", "label": "X (no)" }
          ]
        },
        {
          "type": "select",
          "id": "competitor_check",
          "label": "Competitor (right)",
          "default": "no",
          "options": [
            { "value": "yes", "label": "Check (yes)" },
            { "value": "no", "label": "X (no)" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Comparison VS",
      "blocks": [
        { "type": "row", "settings": { "feature_label": "4,000 FU per capsule (clinical dose)", "brand_check": "yes", "competitor_check": "no" } },
        { "type": "row", "settings": { "feature_label": "Wild-fermented Bacillus subtilis", "brand_check": "yes", "competitor_check": "no" } },
        { "type": "row", "settings": { "feature_label": "Single ingredient — no proprietary blend", "brand_check": "yes", "competitor_check": "no" } },
        { "type": "row", "settings": { "feature_label": "K2-free for blood-thinner compatibility", "brand_check": "yes", "competitor_check": "no" } },
        { "type": "row", "settings": { "feature_label": "FU number printed on the front of the label", "brand_check": "yes", "competitor_check": "no" } },
        { "type": "row", "settings": { "feature_label": "Per-batch COA published (lookup by lot)", "brand_check": "yes", "competitor_check": "no" } },
        { "type": "row", "settings": { "feature_label": "Backed by Chen 2022 (n=1,062, 12 months)", "brand_check": "yes", "competitor_check": "no" } },
        { "type": "row", "settings": { "feature_label": "Dose-flexible (stack 1–3 caps to your protocol)", "brand_check": "yes", "competitor_check": "no" } },
        { "type": "row", "settings": { "feature_label": "Proprietary blends with undisclosed amounts", "brand_check": "no", "competitor_check": "yes" } },
        { "type": "row", "settings": { "feature_label": "K2 bundled without clinician disclosure", "brand_check": "no", "competitor_check": "yes" } },
        { "type": "row", "settings": { "feature_label": "2,000 FU regulatory minimum — sub-clinical", "brand_check": "no", "competitor_check": "yes" } }
      ]
    }
  ]
}
{% endschema %}
