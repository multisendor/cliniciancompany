<div
  data-section-type="benefits-grid"
  class="benefits-grid tcc-section-padding"
  style="background-color: var(--tcc-bg);"
>
  <div class="benefits-grid__inner tcc-page-width">

    <!-- Section Header -->
    <div class="benefits-grid__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="benefits-grid__heading tcc-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="benefits-grid__description tcc-body">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <!-- Cards Grid -->
    {%- if section.blocks.size > 0 -%}
      <div class="benefits-grid__cards">
        {%- for block in section.blocks -%}
          <div class="benefits-grid__card" {{ block.shopify_attributes }}>
            <div class="benefits-grid__card-image">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.image.alt | escape | default: block.settings.title }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}
                    {%- assign fallback_img = 'benefit-heart.jpg' | asset_url -%}
                    {%- assign fallback_alt = 'Heart & Vascular Support' -%}
                  {%- when 2 -%}
                    {%- assign fallback_img = 'benefit-circulation.jpg' | asset_url -%}
                    {%- assign fallback_alt = 'Healthy Circulation' -%}
                  {%- when 3 -%}
                    {%- assign fallback_img = 'benefit-immune.jpg' | asset_url -%}
                    {%- assign fallback_alt = 'Immune & Digestive Support' -%}
                  {%- when 4 -%}
                    {%- assign fallback_img = 'benefit-energy.jpg' | asset_url -%}
                    {%- assign fallback_alt = 'Energy & Daily Wellbeing' -%}
                  {%- else -%}
                    {%- assign fallback_img = 'benefit-heart.jpg' | asset_url -%}
                    {%- assign fallback_alt = block.settings.title -%}
                {%- endcase -%}
                <img
                  src="{{ fallback_img }}"
                  alt="{{ fallback_alt }}"
                  width="400"
                  height="250"
                  loading="lazy"
                  style="width: 100%; height: 100%; object-fit: cover; display: block;"
                >
              {%- endif -%}
            </div>
            <div class="benefits-grid__card-body">
              {%- if block.settings.title != blank -%}
                <h3 class="benefits-grid__card-title tcc-heading">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="benefits-grid__card-description tcc-body">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  .benefits-grid__header {
    text-align: center;
    margin-bottom: 2.5rem;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .benefits-grid__heading {
    font-size: 31.2px;
    line-height: 38px;
    margin: 0 0 0.75rem 0;
    color: var(--tcc-ink);
  }

  .benefits-grid__description {
    font-size: 16px;
    line-height: 28px;
    color: var(--tcc-ink);
    opacity: 0.75;
    margin: 0;
  }

  .benefits-grid__cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .benefits-grid__card {
    background: var(--tcc-card);
    border-radius: var(--tcc-radius);
    box-shadow: var(--tcc-shadow-card);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .benefits-grid__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 0.4rem 2rem rgba(0, 0, 0, 0.12);
  }

  .benefits-grid__card-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--tcc-bg);
  }

  .benefits-grid__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .benefits-grid__card-body {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .benefits-grid__card-title {
    font-size: 22px;
    line-height: 1.25;
    font-weight: var(--tcc-fw-display);
    letter-spacing: -0.3px;
    margin: 0 0 0.6rem 0;
    color: var(--tcc-ink);
  }

  .benefits-grid__card-description {
    font-size: 15px;
    line-height: 1.55;
    color: var(--tcc-ink-soft);
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .benefits-grid__heading {
      font-size: 24px;
    }

    .benefits-grid__cards {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .benefits-grid__card-body {
      padding: 1rem 1.2rem 1.2rem;
    }

    .benefits-grid__card-title {
      font-size: 19px;
    }
  }
</style>

{% schema %}
{
  "name": "Benefits Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What it does, what the research shows"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Structure-function support for the body's natural fibrinolytic system — backed by peer-reviewed human research and a 40-year clinical record."
    }
  ],
  "blocks": [
    {
      "type": "benefit_card",
      "name": "Benefit Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Benefits Grid",
      "blocks": [
        { "type": "benefit_card", "settings": { "title": "Supports fibrinolytic activity", "description": "The body's natural mechanism for clearing excess fibrin." } },
        { "type": "benefit_card", "settings": { "title": "Supports healthy circulation", "description": "Studied for blood-flow markers and arterial wall thickness across multiple human trials." } },
        { "type": "benefit_card", "settings": { "title": "Studied across 40+ years", "description": "Discovered in Tokyo, 1980 by Dr. Hiroyuki Sumi. Dozens of human studies." } },
        { "type": "benefit_card", "settings": { "title": "Dose to your protocol", "description": "4,000 FU per capsule. 1, 2, or 3 capsules per day — your call, with your clinician." } }
      ]
    }
  ]
}
{% endschema %}
