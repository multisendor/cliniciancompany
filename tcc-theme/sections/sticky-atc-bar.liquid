{%- assign bundles = section.blocks | where: "type", "bundle_option" -%}

<div
  data-section-type="sticky-atc-bar"
  class="sticky-atc-bar"
  id="StickyAtcBar"
>
  <div class="sticky-atc-bar__inner">
    <div class="sticky-atc-bar__info">
      <span class="sticky-atc-bar__product-title">{{ product.title | default: settings.brand_name }}</span>
    </div>

    <div class="sticky-atc-bar__actions">
      {%- if bundles.size > 0 -%}
        <select class="sticky-atc-bar__select" id="StickyBundleSelect">
          {%- for block in bundles -%}
            <option value="{{ forloop.index }}">{{ block.settings.title }}</option>
          {%- endfor -%}
        </select>
      {%- endif -%}

      <button type="button" class="sticky-atc-bar__button tcc-btn tcc-btn--primary" id="StickyAtcButton">
        Add to Cart
      </button>
    </div>
  </div>
</div>

<style>
  .sticky-atc-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: var(--tcc-card, #fff);
    box-shadow: 0 -2px 10px rgba(10, 22, 40, 0.10);
    z-index: 100;
    padding: var(--tcc-s-1, 8px) 0;
    transform: translateY(100%);
    transition: transform 0.3s ease-in-out;
  }

  .sticky-atc-bar--visible {
    transform: translateY(0);
  }

  .sticky-atc-bar__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--tcc-s-3, 24px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--tcc-s-2, 16px);
  }

  .sticky-atc-bar__info {
    flex: 1;
    min-width: 0;
  }

  .sticky-atc-bar__product-title {
    font-family: var(--tcc-font-sans);
    font-weight: 500;
    font-size: var(--tcc-fs-small, 13px);
    color: var(--tcc-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }

  .sticky-atc-bar__actions {
    display: flex;
    align-items: center;
    gap: var(--tcc-s-1, 8px);
  }

  .sticky-atc-bar__select {
    padding: 8px 28px 8px 12px;
    border: 1px solid var(--tcc-line);
    border-radius: var(--tcc-radius, 6px);
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-small, 13px);
    color: var(--tcc-ink);
    background: var(--tcc-card, #fff);
  }

  .sticky-atc-bar__button {
    display: inline-block;
    padding: 10px 24px;
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-small, 13px);
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    background: var(--tcc-ink);
    color: var(--tcc-bg);
    border: 0;
    border-radius: var(--tcc-radius, 6px);
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }

  .sticky-atc-bar__button:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 749px) {
    .sticky-atc-bar__info {
      display: none;
    }

    .sticky-atc-bar__actions {
      width: 100%;
    }

    .sticky-atc-bar__select {
      flex: 1;
    }
  }
</style>

<script>
  (function() {
    var bar = document.getElementById('StickyAtcBar');
    if (!bar) return;

    var mainButton = document.querySelector('.product-details-buybox__add-to-cart') || document.querySelector('.product-form__submit');

    if (mainButton) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          bar.classList.toggle('sticky-atc-bar--visible', !entry.isIntersecting);
        });
      }, { threshold: 0 });
      observer.observe(mainButton);
    } else {
      window.addEventListener('scroll', function() {
        bar.classList.toggle('sticky-atc-bar--visible', window.scrollY > 800);
      }, { passive: true });
    }

    // Sync bundle selection with main buybox
    var stickySelect = document.getElementById('StickyBundleSelect');
    var mainRadios = document.querySelectorAll('.product-details-buybox__bundle-radio');

    if (stickySelect && mainRadios.length > 0) {
      stickySelect.addEventListener('change', function() {
        var index = parseInt(this.value) - 1;
        if (mainRadios[index]) {
          mainRadios[index].click();
        }
      });

      // Initial sync
      mainRadios.forEach(function(radio, idx) {
        if (radio.checked) stickySelect.value = (idx + 1).toString();
      });
    }

    // ATC click sync
    var stickyAtc = document.getElementById('StickyAtcButton');
    if (stickyAtc && mainButton) {
      stickyAtc.addEventListener('click', function() {
        mainButton.click();
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Sticky ATC Bar",
  "settings": [],
  "blocks": [
    {
      "type": "bundle_option",
      "name": "Bundle Option",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Bundle Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sticky ATC Bar",
      "blocks": [
        {
          "type": "bundle_option",
          "settings": {
            "title": "Buy One"
          }
        },
        {
          "type": "bundle_option",
          "settings": {
            "title": "Buy 2 Get 1 FREE"
          }
        },
        {
          "type": "bundle_option",
          "settings": {
            "title": "Buy 3 Get 2 FREE"
          }
        }
      ]
    }
  ]
}
{% endschema %}
