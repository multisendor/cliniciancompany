{%- assign product = section.settings.product -%}

<div
  data-section-type="hero-product-showcase"
  class="hero-product-showcase"
  style="background-color: {{ section.settings.background_color | default: 'var(--tcc-bg)' }};"
>
  <div class="hero-product-showcase__inner tcc-page-width tcc-section-padding">
    <!-- Left column: product image -->
    <div class="hero-product-showcase__images">
      <div class="hero-product-showcase__main-image">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1000 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="eager"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            class="{% if section.settings.mobile_image != blank %}hidden-mobile{% endif %}"
          >
        {%- elsif section.settings.external_image_url != blank -%}
          <img
            src="{{ section.settings.external_image_url }}"
            alt="{{ section.settings.heading | escape }}"
            loading="eager"
            width="800"
            height="800"
            class="{% if section.settings.mobile_image != blank %}hidden-mobile{% endif %}"
          >
        {%- else -%}
          {%- comment -%} Intentional CSS hero placeholder when no image is uploaded {%- endcomment -%}
          <div class="tcc-hero-placeholder {% if section.settings.mobile_image != blank %}hidden-mobile{% endif %}">
            <div class="tcc-hero-placeholder__pattern"></div>
            <div class="tcc-hero-placeholder__content">
              <div class="tcc-hero-placeholder__eyebrow">{{ settings.brand_short | default: 'TCC' }} · {{ 'now' | date: '%Y' }}</div>
              <div class="tcc-hero-placeholder__wordmark">{{ settings.brand_short | default: 'TCC' }}</div>
              <div class="tcc-hero-placeholder__rule"></div>
              <div class="tcc-hero-placeholder__tagline">{{ settings.brand_tagline | default: 'Practitioner-Grade Wellness' }}</div>
            </div>
            <div class="tcc-hero-placeholder__corner tcc-hero-placeholder__corner--tl"></div>
            <div class="tcc-hero-placeholder__corner tcc-hero-placeholder__corner--tr"></div>
            <div class="tcc-hero-placeholder__corner tcc-hero-placeholder__corner--bl"></div>
            <div class="tcc-hero-placeholder__corner tcc-hero-placeholder__corner--br"></div>
          </div>
          <style>
            .tcc-hero-placeholder {
              position: relative;
              width: 100%;
              aspect-ratio: 1 / 1;
              background:
                radial-gradient(circle at 30% 20%, rgba(201, 169, 110, 0.18), transparent 60%),
                radial-gradient(circle at 70% 80%, rgba(255, 255, 255, 0.05), transparent 60%),
                var(--tcc-ink, #0a1628);
              overflow: hidden;
              color: #fafbfc;
            }
            .tcc-hero-placeholder__pattern {
              position: absolute; inset: 0;
              background-image:
                linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
              background-size: 32px 32px;
              opacity: 0.6;
              pointer-events: none;
            }
            .tcc-hero-placeholder__content {
              position: absolute; inset: 0;
              display: flex; flex-direction: column;
              align-items: center; justify-content: center;
              text-align: center; padding: 8%;
            }
            .tcc-hero-placeholder__eyebrow {
              font-family: var(--tcc-font-sans, 'Inter', sans-serif);
              font-size: clamp(10px, 1vw, 12px);
              font-weight: 700;
              letter-spacing: 4px;
              text-transform: uppercase;
              color: #c9a96e;
              margin-bottom: 1.5rem;
            }
            .tcc-hero-placeholder__wordmark {
              font-family: 'Cormorant Garamond', Georgia, serif;
              font-size: clamp(80px, 14vw, 220px);
              font-weight: 300;
              line-height: 1;
              letter-spacing: 8px;
              color: #fafbfc;
              margin: 0;
            }
            .tcc-hero-placeholder__rule {
              width: 60px; height: 1px;
              background: #c9a96e;
              margin: 1.5rem 0 1rem;
            }
            .tcc-hero-placeholder__tagline {
              font-family: var(--tcc-font-sans, 'Inter', sans-serif);
              font-size: clamp(11px, 1.1vw, 14px);
              font-weight: 500;
              letter-spacing: 2.5px;
              text-transform: uppercase;
              color: rgba(250, 251, 252, 0.7);
            }
            .tcc-hero-placeholder__corner {
              position: absolute;
              width: 24px; height: 24px;
              border-color: rgba(201, 169, 110, 0.6);
              border-style: solid;
              border-width: 0;
            }
            .tcc-hero-placeholder__corner--tl { top: 24px; left: 24px; border-top-width: 2px; border-left-width: 2px; }
            .tcc-hero-placeholder__corner--tr { top: 24px; right: 24px; border-top-width: 2px; border-right-width: 2px; }
            .tcc-hero-placeholder__corner--bl { bottom: 24px; left: 24px; border-bottom-width: 2px; border-left-width: 2px; }
            .tcc-hero-placeholder__corner--br { bottom: 24px; right: 24px; border-bottom-width: 2px; border-right-width: 2px; }
          </style>
        {%- endif -%}

        {%- if section.settings.mobile_image != blank -%}
          <img
            src="{{ section.settings.mobile_image | image_url: width: 800 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="eager"
            width="{{ section.settings.mobile_image.width }}"
            height="{{ section.settings.mobile_image.height }}"
            class="hidden-desktop"
          >
        {%- endif -%}
      </div>
    </div>

    <!-- Right column: content -->
    <div class="hero-product-showcase__content">
      <!-- Star rating -->
      <div class="hero-product-showcase__rating">
        <span class="tcc-stars">
          <span class="material-symbols-outlined">star</span>
          <span class="material-symbols-outlined">star</span>
          <span class="material-symbols-outlined">star</span>
          <span class="material-symbols-outlined">star</span>
          <span class="material-symbols-outlined">star</span>
        </span>
        <span class="hero-product-showcase__rating-text tcc-body">
          {{ section.settings.rating_text }}
        </span>
      </div>

      <!-- Main heading (large) -->
      {%- if section.settings.subheading != blank -%}
        <h2 class="hero-product-showcase__subtitle">
          {{ section.settings.subheading }}
        </h2>
      {%- endif -%}

      <!-- Product name -->
      <p class="hero-product-showcase__heading">
        {{ section.settings.heading }}
      </p>

      <!-- Body text -->
      {%- if section.settings.body_text != blank -%}
        <div class="hero-product-showcase__body tcc-body">
          {{ section.settings.body_text }}
        </div>
      {%- endif -%}

      <!-- CTA button -->
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="tcc-btn tcc-btn--primary hero-product-showcase__cta"
      >
        {{ section.settings.button_text }}
      </a>

      <!-- Guarantee line -->
      <div class="hero-product-showcase__guarantee tcc-body">
        <span class="material-symbols-outlined hero-product-showcase__guarantee-icon">workspace_premium</span>
        <span>30-day money-back guarantee</span>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-product-showcase__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  /* Left column: image */
  .hero-product-showcase__main-image {
    border-radius: var(--tcc-radius);
    overflow: hidden;
    background: var(--tcc-card);
  }

  .hero-product-showcase__main-image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  /* Right column: content */
  .hero-product-showcase__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
    align-items: center;
  }

  .hero-product-showcase__rating {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-product-showcase__rating .tcc-stars .material-symbols-outlined {
    font-size: 20px;
  }

  .hero-product-showcase__rating-text {
    font-size: 15.2px;
    line-height: 28px;
    color: var(--tcc-ink);
  }

  .hero-product-showcase__subtitle {
    font-family: var(--tcc-font-heading);
    font-weight: var(--tcc-fw-display);
    font-size: clamp(40px, 5vw, 60px);
    line-height: 1.05;
    letter-spacing: var(--tcc-ls-display);
    color: var(--tcc-ink);
    margin: 0;
  }

  .hero-product-showcase__heading {
    font-size: 21.4px;
    line-height: 27.8px;
    margin: 0;
    color: var(--tcc-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-weight: 500;
  }

  .hero-product-showcase__heading .material-symbols-outlined {
    color: var(--tcc-ink);
    font-size: 1.3em;
    font-variation-settings: 'FILL' 1;
  }

  .hero-product-showcase__body {
    font-size: 16px;
    line-height: 28px;
    color: var(--tcc-ink);
    opacity: 0.85;
  }

  .hero-product-showcase__cta {
    width: 100%;
    margin-top: 0.5rem;
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 15.2px;
    line-height: 20px;
    padding: 1.5rem 2rem !important;
  }

  .hero-product-showcase__guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 1.5rem;
    line-height: 19.8px;
    color: var(--tcc-ink);
    opacity: 0.75;
    margin-top: 0.3rem;
  }

  .hero-product-showcase__cta {
    align-self: stretch;
  }

  @media screen and (min-width: 750px) {
    .hero-product-showcase__guarantee {
      font-size: 1.6rem;
    }
  }

  .hero-product-showcase__guarantee-icon {
    font-size: 18px;
    color: var(--tcc-ink);
  }

  .hero-product-showcase__main-image img.hidden-desktop {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .hero-product-showcase__main-image img.hidden-mobile {
      display: none;
    }
    .hero-product-showcase__main-image img.hidden-desktop {
      display: block;
    }
    .hero-product-showcase__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-bottom: 1.5rem !important;
    }

    .hero-product-showcase__subtitle {
      font-size: 36px;
      line-height: 1.1;
    }

    .hero-product-showcase__heading {
      font-size: 18px;
    }

    .hero-product-showcase__copy {
      text-align: center;
    }

    .hero-product-showcase__rating,
    .hero-product-showcase__guarantee {
      justify-content: center;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Product Showcase",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "text",
      "id": "external_image_url",
      "label": "External Image URL (overrides picker)",
      "info": "Placeholder URL while real product photography is in production. Replace via the image picker above when ready.",
      "default": "https://www.twc.health/cdn/shop/files/SIG_UltSpike_Thumbnail.png?v=1773419148&width=1200"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clear arteries. Restored circulation."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtitle Tag (Eyebrow)",
      "default": "Practitioner-Grade · Clinically Studied"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body Text",
      "default": "<p>Practitioner-grade nattokinase, formulated by clinicians for the cardiovascular health you deserve.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop the Protocol"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "Rated 4.8 / 5 | Trusted By 50,000+"
    }
  ],
  "presets": [
    {
      "name": "Hero Product Showcase",
      "settings": {
        "heading": "Clear arteries. Restored circulation.",
        "subheading": "Practitioner-Grade · Clinically Studied",
        "body_text": "<p>Practitioner-grade nattokinase, formulated by clinicians for the cardiovascular health you deserve.</p>",
        "button_text": "Shop the Protocol",
        "button_link": "/products/spike-detox"
      }
    }
  ]
}
{% endschema %}
