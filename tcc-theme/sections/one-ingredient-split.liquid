{%- comment -%}
  One Ingredient Split — simplified to a single hero graphic.

  Renders one image (paste a Shopify CDN URL into `image_url` from the
  theme editor). When blank, shows a placeholder so layout is preserved.

  Replaces the prior complex bottle+corner-icons SVG layout that was
  composed in liquid; the new approach is one editorially-controlled
  image asset (lets the designer iterate without code changes).
{%- endcomment -%}

<div
  data-section-type="one-ingredient-split"
  data-section-id="{{ section.id }}"
  class="one-ingredient-split tcc-section-padding"
>
  <div class="one-ingredient-split__inner tcc-page-width">
    {%- if section.settings.image_url != blank -%}
      <img
        class="one-ingredient-split__image"
        src="{{ section.settings.image_url }}"
        alt="{{ section.settings.image_alt | default: 'Spike Detox bottle with key benefits' | escape }}"
        loading="lazy"
      >
    {%- else -%}
      <div class="one-ingredient-split__placeholder" role="img" aria-label="Image placeholder">
        <div class="one-ingredient-split__placeholder-inner">
          <div class="one-ingredient-split__placeholder-eyebrow">Image placeholder</div>
          <div class="one-ingredient-split__placeholder-title">Spike Detox key-benefits graphic</div>
          <div class="one-ingredient-split__placeholder-hint">
            Upload the bottle + corner-icons image to Shopify Files, then paste the CDN URL into
            <strong>Theme editor → One Ingredient Split → Image URL</strong>.
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .one-ingredient-split {
    background: #ffffff;
  }

  .one-ingredient-split__inner {
    max-width: 1240px;
    text-align: center;
  }

  .one-ingredient-split__image {
    display: block;
    width: 100%;
    max-width: 1240px;
    height: auto;
    margin: 0 auto;
    border-radius: 24px;
  }

  /* Placeholder block — only shown when image_url is blank.
     Same approximate aspect ratio + blue brand bg as the eventual image
     so the page layout doesn't jump when the real asset lands. */
  .one-ingredient-split__placeholder {
    width: 100%;
    max-width: 1240px;
    aspect-ratio: 1240 / 1100;
    margin: 0 auto;
    background: var(--tcc-cta-accent, #1e40af);
    border-radius: 24px;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8%;
  }

  .one-ingredient-split__placeholder-inner {
    max-width: 560px;
    text-align: center;
    border: 2px dashed rgba(255, 255, 255, 0.45);
    border-radius: 16px;
    padding: 40px 32px;
  }

  .one-ingredient-split__placeholder-eyebrow {
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-eyebrow, 11px);
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 12px;
  }

  .one-ingredient-split__placeholder-title {
    font-family: var(--tcc-font-heading);
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .one-ingredient-split__placeholder-hint {
    font-family: var(--tcc-font-sans);
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.85;
  }

  .one-ingredient-split__placeholder-hint strong {
    font-weight: 700;
  }

  @media (max-width: 749px) {
    .one-ingredient-split__placeholder {
      aspect-ratio: 4 / 5;
      padding: 6%;
    }
    .one-ingredient-split__placeholder-inner {
      padding: 28px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "One Ingredient Split",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL (Shopify CDN)",
      "info": "Paste the full https://cdn.shopify.com/... URL after uploading the image to Settings → Files."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Spike Detox bottle with key benefits — 4,000 FU per capsule, wild-fermented Bacillus subtilis, K2-free, third-party tested, single ingredient"
    }
  ],
  "presets": [
    {
      "name": "One Ingredient Split"
    }
  ]
}
{% endschema %}
