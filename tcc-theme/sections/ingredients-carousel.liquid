<div
  class="ingredients-carousel tcc-section-padding"
  data-section-type="ingredients-carousel"
  data-section-id="{{ section.id }}"
  style="--ic-bg: {{ section.settings.background_color }};"
>
  <div class="tcc-page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="ingredients-carousel__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="ingredients-carousel__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ingredients-carousel__viewport">
        <button
          type="button"
          class="ingredients-carousel__arrow ingredients-carousel__arrow--prev"
          aria-label="Previous ingredient"
          data-ic-prev
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="ingredients-carousel__track" data-ic-track tabindex="0" role="region" aria-label="Science-backed ingredients carousel">
          {%- for block in section.blocks -%}
            <article class="ingredients-carousel__card" {{ block.shopify_attributes }}>
              <div class="ingredients-carousel__image-wrap">
                {%- if block.settings.image_url != blank -%}
                  <img
                    class="ingredients-carousel__image"
                    src="{{ block.settings.image_url }}"
                    alt="{{ block.settings.image_alt | escape }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}
                <h3 class="ingredients-carousel__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="ingredients-carousel__description">{{ block.settings.description }}</p>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>

        <button
          type="button"
          class="ingredients-carousel__arrow ingredients-carousel__arrow--next"
          aria-label="Next ingredient"
          data-ic-next
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <div class="ingredients-carousel__dots" data-ic-dots role="tablist" aria-label="Carousel pagination">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="ingredients-carousel__dot{% if forloop.first %} is-active{% endif %}"
            data-ic-dot="{{ forloop.index0 }}"
            aria-label="Go to ingredient {{ forloop.index }}"
            role="tab"
            {% if forloop.first %}aria-selected="true"{% endif %}
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .ingredients-carousel {
    background: var(--ic-bg, #f2f7f9);
    color: var(--tcc-ink, #163450);
  }

  .ingredients-carousel__heading {
    font-family: var(--tcc-font-heading);
    font-weight: 700;
    font-size: 30px;
    line-height: 36px;
    letter-spacing: normal;
    color: var(--tcc-ink, #163450);
    text-align: center;
    margin: 0 0 var(--tcc-s-2, 16px);
  }

  .ingredients-carousel__subheading {
    font-family: var(--tcc-font-heading);
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: var(--tcc-ink-soft, #4a5b6e);
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--tcc-s-6, 48px);
  }

  .ingredients-carousel__viewport {
    position: relative;
  }

  .ingredients-carousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 72px) / 4);
    gap: 24px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 8px 4px 16px;
    margin: 0 -4px;
  }

  .ingredients-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .ingredients-carousel__card {
    background: #ffffff;
    border-radius: 16px;
    padding: 32px 24px 28px;
    box-shadow: 0 2px 12px rgba(20, 40, 70, 0.06);
    text-align: center;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ingredients-carousel__image-wrap {
    width: 100%;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .ingredients-carousel__image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .ingredients-carousel__title {
    font-family: var(--tcc-font-heading);
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
    color: var(--tcc-ink, #163450);
    margin: 0 0 10px;
    letter-spacing: normal;
  }

  .ingredients-carousel__description {
    font-family: var(--tcc-font-sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #6a6a6a;
    margin: 0;
  }

  .ingredients-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #ffffff;
    color: var(--tcc-ink, #163450);
    border: 1px solid rgba(20, 40, 70, 0.1);
    box-shadow: 0 4px 14px rgba(20, 40, 70, 0.12);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    padding: 0;
    transition: opacity 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }

  .ingredients-carousel__arrow:hover {
    box-shadow: 0 6px 18px rgba(20, 40, 70, 0.18);
  }

  .ingredients-carousel__arrow:focus-visible {
    outline: 2px solid var(--tcc-accent-blue, #2658d6);
    outline-offset: 2px;
  }

  .ingredients-carousel__arrow[disabled] {
    opacity: 0.35;
    cursor: default;
    box-shadow: 0 2px 8px rgba(20, 40, 70, 0.08);
  }

  .ingredients-carousel__arrow--prev {
    left: -22px;
  }

  .ingredients-carousel__arrow--next {
    right: -22px;
  }

  .ingredients-carousel__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: var(--tcc-s-4, 32px);
  }

  .ingredients-carousel__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(20, 40, 70, 0.2);
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: background 0.18s ease, transform 0.18s ease;
  }

  .ingredients-carousel__dot:hover {
    background: rgba(20, 40, 70, 0.4);
  }

  .ingredients-carousel__dot.is-active {
    background: var(--tcc-ink, #163450);
    transform: scale(1.25);
  }

  .ingredients-carousel__dot:focus-visible {
    outline: 2px solid var(--tcc-accent-blue, #2658d6);
    outline-offset: 2px;
  }

  @media screen and (max-width: 989px) {
    .ingredients-carousel__track {
      grid-auto-columns: calc((100% - 24px) / 2);
      gap: 16px;
    }
    .ingredients-carousel__arrow--prev { left: -8px; }
    .ingredients-carousel__arrow--next { right: -8px; }
  }

  @media screen and (max-width: 749px) {
    .ingredients-carousel__heading {
      font-size: 26.6px;
      line-height: 31.92px;
    }
    .ingredients-carousel__subheading {
      font-size: 15.6px;
      line-height: 23.4px;
    }
    .ingredients-carousel__track {
      grid-auto-columns: calc(100% - 24px);
      gap: 12px;
      padding-left: 12px;
      padding-right: 12px;
      margin: 0 -12px;
    }
    .ingredients-carousel__image-wrap {
      height: 180px;
    }
    .ingredients-carousel__arrow {
      display: none;
    }
  }
</style>

<script>
  (function () {
    var roots = document.querySelectorAll('[data-section-type="ingredients-carousel"]');
    roots.forEach(function (root) {
      var track = root.querySelector('[data-ic-track]');
      if (!track) return;
      var prev = root.querySelector('[data-ic-prev]');
      var next = root.querySelector('[data-ic-next]');
      var dots = Array.prototype.slice.call(root.querySelectorAll('[data-ic-dot]'));
      var cards = Array.prototype.slice.call(track.querySelectorAll('.ingredients-carousel__card'));
      if (cards.length === 0) return;

      function stepWidth() {
        var card = cards[0];
        if (!card) return track.clientWidth;
        var rect = card.getBoundingClientRect();
        var style = window.getComputedStyle(track);
        var gap = parseFloat(style.columnGap || style.gap || '0') || 0;
        return rect.width + gap;
      }

      function currentIndex() {
        var w = stepWidth();
        if (w <= 0) return 0;
        return Math.round(track.scrollLeft / w);
      }

      function visibleCount() {
        var w = stepWidth();
        if (w <= 0) return 1;
        return Math.max(1, Math.round(track.clientWidth / w));
      }

      function maxIndex() {
        return Math.max(0, cards.length - visibleCount());
      }

      function updateDots() {
        var idx = currentIndex();
        var max = maxIndex();
        if (idx > max) idx = max;
        dots.forEach(function (d, i) {
          var active = i === idx;
          d.classList.toggle('is-active', active);
          if (active) {
            d.setAttribute('aria-selected', 'true');
          } else {
            d.removeAttribute('aria-selected');
          }
        });
        if (prev) prev.toggleAttribute('disabled', track.scrollLeft <= 2);
        if (next) next.toggleAttribute('disabled', track.scrollLeft + track.clientWidth >= track.scrollWidth - 2);
      }

      function scrollToIndex(i) {
        var w = stepWidth();
        var max = maxIndex();
        if (i < 0) i = 0;
        if (i > max) i = max;
        track.scrollTo({ left: i * w, behavior: 'smooth' });
      }

      if (prev) prev.addEventListener('click', function () {
        scrollToIndex(currentIndex() - 1);
      });
      if (next) next.addEventListener('click', function () {
        scrollToIndex(currentIndex() + 1);
      });

      dots.forEach(function (d) {
        d.addEventListener('click', function () {
          var i = parseInt(d.getAttribute('data-ic-dot'), 10) || 0;
          scrollToIndex(i);
        });
      });

      var scrollTimer = null;
      track.addEventListener('scroll', function () {
        if (scrollTimer) window.cancelAnimationFrame(scrollTimer);
        scrollTimer = window.requestAnimationFrame(updateDots);
      });

      window.addEventListener('resize', updateDots);
      updateDots();
    });
  })();
</script>

{% schema %}
