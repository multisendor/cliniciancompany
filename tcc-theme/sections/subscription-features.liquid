<div
  class="subscription-features tcc-section-padding"
  data-section-type="subscription-features"
  data-section-id="{{ section.id }}"
>
  <div class="tcc-page-width">

    {%- if section.blocks.size > 0 -%}
      <div class="subscription-features__grid subscription-features__grid--{{ section.blocks.size }}-cols">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            <div
              class="subscription-features__cell{% if forloop.index > 1 and section.settings.show_dividers %} subscription-features__cell--divided{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="subscription-features__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'refresh' -%}
                    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" width="28" height="28" aria-hidden="true" focusable="false">
                      <path d="M6 16a10 10 0 0 1 10-10c3.4 0 6.4 1.7 8.2 4.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <path d="M26 16a10 10 0 0 1-10 10c-3.4 0-6.4-1.7-8.2-4.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <path d="M22 6l2.5 4.3-4.3 2.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M10 26l-2.5-4.3 4.3-2.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- when 'x_circle' -%}
                    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" width="28" height="28" aria-hidden="true" focusable="false">
                      <circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M12 12 L20 20 M20 12 L12 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" width="28" height="28" aria-hidden="true" focusable="false">
                      <rect x="2" y="9" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M22 13h5.2l2.8 5v5h-8V13Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                      <circle cx="8" cy="25" r="2.5" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="24" cy="25" r="2.5" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  {%- when 'lock' -%}
                    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" width="28" height="28" aria-hidden="true" focusable="false">
                      <rect x="7" y="15" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M11 15V11a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <circle cx="16" cy="21" r="1.5" fill="currentColor"/>
                    </svg>
                  {%- when 'tag' -%}
                    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" width="28" height="28" aria-hidden="true" focusable="false">
                      <path d="M4 4h10l14 14a2 2 0 0 1 0 2.8l-7.2 7.2a2 2 0 0 1-2.8 0L4 14V4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                      <circle cx="10" cy="10" r="1.5" fill="currentColor"/>
                    </svg>
                  {%- else -%}
                    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" width="28" height="28" aria-hidden="true" focusable="false">
                      <circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                {%- endcase -%}
              </div>

              {%- if block.settings.heading != blank -%}
                <p class="subscription-features__heading">{{ block.settings.heading }}</p>
              {%- endif -%}

              {%- if block.settings.sub != blank -%}
                <p class="subscription-features__sub">{{ block.settings.sub }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  .subscription-features {
    background: var(--tcc-bg);
    border-top: 1px solid var(--tcc-line);
    border-bottom: 1px solid var(--tcc-line);
  }

  .subscription-features__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  /* Dynamic column count up to 4 */
  .subscription-features__grid--4-cols {
    grid-template-columns: repeat(4, 1fr);
  }

  .subscription-features__cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--tcc-s-2, 16px);
    padding: var(--tcc-s-3, 24px) var(--tcc-s-3, 24px);
  }

  .subscription-features__cell--divided {
    border-left: 1px solid var(--tcc-line);
  }

  .subscription-features__icon {
    color: var(--tcc-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
  }

  .subscription-features__heading {
    font-family: var(--tcc-font-heading);
    font-size: var(--tcc-fs-body, 16px);
    font-weight: 700;
    color: var(--tcc-ink);
    margin: 0;
    line-height: 1.3;
  }

  .subscription-features__sub {
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-small, 13px);
    color: var(--tcc-ink-soft);
    margin: 0;
    line-height: 1.45;
  }

  @media screen and (max-width: 749px) {
    .subscription-features__cell--divided {
      border-left: none;
    }
  }

  @media screen and (max-width: 599px) {
    .subscription-features__grid,
    .subscription-features__grid--4-cols {
      grid-template-columns: 1fr;
    }
    .subscription-features__cell {
      border-top: 1px solid var(--tcc-line);
    }
    .subscription-features__cell:first-child {
      border-top: none;
    }
  }
</style>

{% schema %}
{
  "name": "Subscription Features",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show vertical dividers between cells",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "refresh", "label": "Refresh (auto-refill)" },
            { "value": "x_circle", "label": "X circle (cancel)" },
            { "value": "truck", "label": "Truck (delivery)" },
            { "value": "lock", "label": "Lock (secure)" },
            { "value": "tag", "label": "Tag (savings)" }
          ],
          "default": "refresh"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Auto-refill every 30 days"
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Sub-text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subscription Features",
      "blocks": [
        { "type": "feature", "settings": { "icon": "refresh", "heading": "Auto-refill every 30 days", "sub": "Set it and forget it" } },
        { "type": "feature", "settings": { "icon": "x_circle", "heading": "Cancel anytime", "sub": "No commitments" } },
        { "type": "feature", "settings": { "icon": "truck", "heading": "3-6 day delivery", "sub": "Ships from US warehouse" } }
      ]
    }
  ]
}
{% endschema %}
