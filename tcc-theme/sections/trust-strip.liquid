<div
  class="trust-strip tcc-section-padding"
  data-section-type="trust-strip"
  data-section-id="{{ section.id }}"
>
  <div class="tcc-page-width">
    <div class="trust-strip__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="trust-strip__eyebrow tcc-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="trust-strip__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="trust-strip__grid">
        {%- for block in section.blocks -%}
          <div class="trust-strip__cell" {{ block.shopify_attributes }}>
            <div class="trust-strip__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}
                  <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M16 4 6 8v8.5C6 22 10.5 26.5 16 28c5.5-1.5 10-6 10-11.5V8L16 4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="m12 16 3 3 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- when 'lab' -%}
                  <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M13 4v8.5L7 24a2 2 0 0 0 1.7 3h14.6A2 2 0 0 0 25 24l-6-11.5V4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M11 4h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M10 19h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="2 2"/>
                  </svg>
                {%- when 'leaf' -%}
                  <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M26 6c-9 0-16 5-16 13 0 4 2 7 5 8 6 1 13-4 13-13V6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M6 28C9 22 14 16 24 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                {%- when 'checkmark' -%}
                  <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="1.5"/>
                    <path d="m11 16 4 4 7-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- when 'globe' -%}
                  <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M4 16h24" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M16 4c4 4 4 20 0 24" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M16 4c-4 4-4 20 0 24" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                {%- when 'test_tube' -%}
                  <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M12 4h8v17a4 4 0 0 1-8 0V4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M10 4h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M12 16h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                {%- else -%}
                  <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
              {%- endcase -%}
            </div>
            {%- if block.settings.label != blank -%}
              <span class="trust-strip__label">{{ block.settings.label }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .trust-strip {
    background: var(--tcc-bg);
  }

  .trust-strip__header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto var(--tcc-s-4, 32px);
  }

  .trust-strip__eyebrow {
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-eyebrow, 11px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--tcc-ink-soft);
    margin: 0 0 var(--tcc-s-2, 16px);
  }

  .trust-strip__heading {
    font-family: var(--tcc-font-sans);
    font-weight: 500;
    font-size: clamp(20px, 2.4vw, 26px);
    color: var(--tcc-ink);
    margin: 0;
    line-height: 1.3;
  }

  .trust-strip__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--tcc-s-2, 16px);
    align-items: start;
  }

  .trust-strip__cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--tcc-s-2, 16px);
    padding: var(--tcc-s-2, 16px) 4px;
  }

  .trust-strip__icon {
    width: 36px;
    height: 36px;
    color: var(--tcc-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .trust-strip__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .trust-strip__label {
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-small, 13px);
    font-weight: 500;
    color: var(--tcc-ink);
    line-height: 1.35;
  }

  @media screen and (max-width: 989px) {
    .trust-strip__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--tcc-s-3, 24px) var(--tcc-s-2, 16px);
    }
  }

  @media screen and (max-width: 599px) {
    .trust-strip__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

{% schema %}
{
  "name": "Trust Strip",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What's behind every batch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for the people who read the label."
    }
  ],
  "blocks": [
    {
      "type": "mark",
      "name": "Trust mark",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "lab", "label": "Lab flask" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "checkmark", "label": "Checkmark" },
            { "value": "globe", "label": "Globe" },
            { "value": "test_tube", "label": "Test tube" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Mark label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Strip",
      "blocks": [
        {
          "type": "mark",
          "settings": {
            "icon": "shield",
            "label": "Third-party tested"
          }
        },
        {
          "type": "mark",
          "settings": {
            "icon": "lab",
            "label": "GMP-certified"
          }
        },
        {
          "type": "mark",
          "settings": {
            "icon": "globe",
            "label": "Made in USA"
          }
        },
        {
          "type": "mark",
          "settings": {
            "icon": "leaf",
            "label": "Single ingredient"
          }
        },
        {
          "type": "mark",
          "settings": {
            "icon": "test_tube",
            "label": "COA per batch"
          }
        },
        {
          "type": "mark",
          "settings": {
            "icon": "checkmark",
            "label": "60-day money-back"
          }
        }
      ]
    }
  ]
}
{% endschema %}
