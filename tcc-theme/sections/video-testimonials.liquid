<div
  class="video-testimonials tcc-section-padding"
  data-section-type="video-testimonials"
  data-section-id="{{ section.id }}"
>
  <div class="tcc-page-width">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="video-testimonials__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="video-testimonials__eyebrow tcc-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="video-testimonials__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="video-testimonials__track video-testimonials__track--{{ section.settings.layout }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'video_card' -%}
            {%- assign has_video = false -%}
            {%- if block.settings.video_url != blank -%}
              {%- assign has_video = true -%}
            {%- endif -%}
            <div
              class="video-testimonials__card"
              {{ block.shopify_attributes }}
            >
              {%- if has_video -%}
                <a
                  class="video-testimonials__thumb-link"
                  href="{{ block.settings.video_url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Watch {{ block.settings.name | escape }}'s story"
                >
              {%- else -%}
                <div class="video-testimonials__thumb-link video-testimonials__thumb-link--noop">
              {%- endif -%}

                <div class="video-testimonials__thumb-wrap">
                  {%- if block.settings.thumbnail != blank -%}
                    <img
                      class="video-testimonials__thumb-img"
                      src="{{ block.settings.thumbnail | image_url: width: 600 }}"
                      srcset="
                        {{ block.settings.thumbnail | image_url: width: 300 }} 300w,
                        {{ block.settings.thumbnail | image_url: width: 600 }} 600w
                      "
                      sizes="(max-width: 599px) 85vw, (max-width: 989px) 45vw, 30vw"
                      alt="{{ block.settings.thumbnail.alt | default: block.settings.name | escape }}"
                      loading="lazy"
                      width="{{ block.settings.thumbnail.width }}"
                      height="{{ block.settings.thumbnail.height }}"
                    >
                  {%- else -%}
                    <div class="video-testimonials__thumb-img video-testimonials__thumb--placeholder"></div>
                  {%- endif -%}

                  <div class="video-testimonials__play" aria-hidden="true">
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48">
                      <circle cx="24" cy="24" r="24" fill="rgba(255,255,255,0.18)"/>
                      <circle cx="24" cy="24" r="22" stroke="rgba(255,255,255,0.7)" stroke-width="1.5"/>
                      <polygon points="20,16 36,24 20,32" fill="#ffffff"/>
                    </svg>
                  </div>

                  {%- if block.settings.duration != blank -%}
                    <span class="video-testimonials__duration">{{ block.settings.duration }}</span>
                  {%- endif -%}
                </div>

              {%- if has_video -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}

              <div class="video-testimonials__meta">
                {%- if block.settings.name != blank -%}
                  <p class="video-testimonials__name">{{ block.settings.name }}</p>
                {%- endif -%}
                {%- if block.settings.caption != blank -%}
                  <p class="video-testimonials__caption">{{ block.settings.caption }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  .video-testimonials {
    background: var(--tcc-bg);
  }

  .video-testimonials__header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--tcc-s-4, 32px);
  }

  .video-testimonials__eyebrow {
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-eyebrow, 11px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--tcc-ink-soft);
    margin: 0 0 var(--tcc-s-2, 16px);
  }

  .video-testimonials__heading {
    font-family: var(--tcc-font-sans);
    font-weight: 600;
    font-size: clamp(20px, 2.4vw, 28px);
    color: var(--tcc-ink);
    margin: 0;
    line-height: 1.25;
  }

  /* --- Track (horizontal by default) --- */
  .video-testimonials__track--horizontal {
    display: flex;
    gap: var(--tcc-s-3, 24px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }
  .video-testimonials__track--horizontal::-webkit-scrollbar {
    display: none;
  }

  .video-testimonials__track--horizontal .video-testimonials__card {
    flex: 0 0 calc(33.333% - 16px);
    scroll-snap-align: start;
  }

  /* --- Grid layout --- */
  .video-testimonials__track--grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--tcc-s-3, 24px);
  }

  /* --- Card --- */
  .video-testimonials__card {
    display: flex;
    flex-direction: column;
    gap: var(--tcc-s-2, 16px);
  }

  .video-testimonials__thumb-link {
    display: block;
    text-decoration: none;
    cursor: pointer;
  }

  .video-testimonials__thumb-link--noop {
    cursor: default;
  }

  .video-testimonials__thumb-wrap {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 12px;
    overflow: hidden;
    background: #111827;
  }

  .video-testimonials__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .video-testimonials__thumb--placeholder {
    background: linear-gradient(135deg, var(--tcc-ink, #111827) 0%, #1a2840 100%);
  }
  .video-testimonials__thumb--placeholder::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 30% 70%, rgba(255,255,255,0.06) 0%, transparent 60%);
  }

  .video-testimonials__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .video-testimonials__thumb-link:hover .video-testimonials__play svg circle:first-child {
    fill: rgba(255,255,255,0.28);
  }

  .video-testimonials__duration {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(0,0,0,0.55);
    color: #fff;
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-small, 13px);
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.3px;
  }

  .video-testimonials__meta {
    text-align: center;
  }

  .video-testimonials__name {
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-body, 16px);
    font-weight: 600;
    color: var(--tcc-ink);
    margin: 0;
    line-height: 1.3;
  }

  .video-testimonials__caption {
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-small, 13px);
    color: var(--tcc-ink-soft);
    margin: 4px 0 0;
    line-height: 1.45;
  }

  /* --- Tablet (989px) --- */
  @media screen and (max-width: 989px) {
    .video-testimonials__track--horizontal .video-testimonials__card {
      flex: 0 0 calc(50% - 12px);
    }
    .video-testimonials__track--grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* --- Mobile (599px) --- */
  @media screen and (max-width: 599px) {
    .video-testimonials__track--horizontal .video-testimonials__card {
      flex: 0 0 82vw;
    }
    .video-testimonials__track--grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Video Testimonials",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "YOUR HEALTH. YOUR STORIES."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real customers, real recovery."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "horizontal", "label": "Horizontal carousel" },
        { "value": "grid", "label": "Grid (3-up)" }
      ],
      "default": "horizontal"
    }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video card",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (YouTube/Vimeo/direct mp4)"
        },
        {
          "type": "text",
          "id": "duration",
          "label": "Duration text",
          "default": "1:24"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Testimonials",
      "blocks": [
        { "type": "video_card", "settings": { "name": "Shaun", "caption": "His story.", "duration": "1:24" } },
        { "type": "video_card", "settings": { "name": "Gina", "caption": "Her story.", "duration": "0:56" } },
        { "type": "video_card", "settings": { "name": "Taylor", "caption": "Their story.", "duration": "1:12" } }
      ]
    }
  ]
}
{% endschema %}
