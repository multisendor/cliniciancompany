<div
  class="video-testimonials tcc-section-padding"
  data-section-type="video-testimonials"
  data-section-id="{{ section.id }}"
>
  <div class="tcc-page-width">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="video-testimonials__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="video-testimonials__eyebrow tcc-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="video-testimonials__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="video-testimonials__nav">
        <button
          class="video-testimonials__arrow video-testimonials__arrow--prev"
          type="button"
          aria-label="Previous"
          data-vt-prev
        >
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true">
            <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="video-testimonials__track video-testimonials__track--{{ section.settings.layout }}" data-vt-track>
          {%- for block in section.blocks -%}
            {%- if block.type == 'video_card' -%}
              {%- assign has_video = false -%}
              {%- if block.settings.video_url != blank -%}
                {%- assign has_video = true -%}
              {%- endif -%}
              <div
                class="video-testimonials__card"
                {{ block.shopify_attributes }}
              >
                {%- if has_video -%}
                  <a
                    class="video-testimonials__thumb-link"
                    href="{{ block.settings.video_url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Watch {{ block.settings.name | escape }}'s story"
                  >
                {%- else -%}
                  <div class="video-testimonials__thumb-link video-testimonials__thumb-link--noop">
                {%- endif -%}

                  <div class="video-testimonials__thumb-wrap">
                    {%- if block.settings.thumbnail != blank -%}
                      <img
                        class="video-testimonials__thumb-img"
                        src="{{ block.settings.thumbnail | image_url: width: 600 }}"
                        srcset="
                          {{ block.settings.thumbnail | image_url: width: 300 }} 300w,
                          {{ block.settings.thumbnail | image_url: width: 600 }} 600w
                        "
                        sizes="(max-width: 599px) 85vw, (max-width: 989px) 45vw, 25vw"
                        alt="{{ block.settings.thumbnail.alt | default: block.settings.name | escape }}"
                        loading="lazy"
                        width="{{ block.settings.thumbnail.width }}"
                        height="{{ block.settings.thumbnail.height }}"
                      >
                    {%- else -%}
                      <div class="video-testimonials__thumb-img video-testimonials__thumb--placeholder">
                        {%- if block.settings.name != blank -%}
                          <span class="video-testimonials__placeholder-label">{{ block.settings.name }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}

                    <div class="video-testimonials__play" aria-hidden="true">
                      <span class="video-testimonials__play-circle">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="22" height="22" aria-hidden="true">
                          <polygon points="8,5 19,12 8,19" fill="#111827"/>
                        </svg>
                      </span>
                    </div>

                    {%- if block.settings.duration != blank -%}
                      <span class="video-testimonials__duration">{{ block.settings.duration }}</span>
                    {%- endif -%}
                  </div>

                {%- if has_video -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <button
          class="video-testimonials__arrow video-testimonials__arrow--next"
          type="button"
          aria-label="Next"
          data-vt-next
        >
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true">
            <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    {%- endif -%}

    {%- if section.settings.show_cta and section.settings.cta_text != blank -%}
      <div class="video-testimonials__cta-wrap">
        {%- if section.settings.cta_link != blank -%}
          <a class="video-testimonials__cta" href="{{ section.settings.cta_link }}">
            {{ section.settings.cta_text }}
          </a>
        {%- else -%}
          <span class="video-testimonials__cta video-testimonials__cta--noop">
            {{ section.settings.cta_text }}
          </span>
        {%- endif -%}

        {%- if section.settings.guarantee_text != blank -%}
          <p class="video-testimonials__guarantee">
            <svg class="video-testimonials__shield" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" aria-hidden="true">
              <path d="M12 2L4 5V11C4 16 7.5 20 12 22C16.5 20 20 16 20 11V5L12 2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
              <path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>{{ section.settings.guarantee_text }}</span>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  .video-testimonials {
    background: var(--tcc-bg);
  }

  .video-testimonials__header {
    text-align: center;
    max-width: 880px;
    margin: 0 auto var(--tcc-s-5, 40px);
  }

  .video-testimonials__eyebrow {
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-eyebrow, 11px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--tcc-ink-soft);
    margin: 0 0 var(--tcc-s-2, 16px);
  }

  .video-testimonials__heading {
    font-family: var(--tcc-font-sans);
    font-weight: 700;
    font-size: 35px;
    line-height: 42px;
    color: #000;
    margin: 0;
    letter-spacing: -0.2px;
  }

  /* --- Nav wrapper (arrows + track) --- */
  .video-testimonials__nav {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr 48px;
    align-items: center;
    gap: 16px;
  }

  /* --- Arrows --- */
  .video-testimonials__arrow {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: #e8eaed;
    color: #1f2937;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.18s ease, transform 0.18s ease;
    -webkit-appearance: none;
    appearance: none;
    padding: 0;
    flex-shrink: 0;
  }
  .video-testimonials__arrow:hover {
    background: #d8dbe0;
  }
  .video-testimonials__arrow:active {
    transform: scale(0.96);
  }
  .video-testimonials__arrow:focus-visible {
    outline: 2px solid #1f2937;
    outline-offset: 2px;
  }

  /* --- Track: 4-up grid on desktop --- */
  .video-testimonials__track {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    min-width: 0;
  }

  /* horizontal/grid layout settings both map to the same 4-up grid on desktop */
  .video-testimonials__track--horizontal,
  .video-testimonials__track--grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  /* --- Card --- */
  .video-testimonials__card {
    display: block;
  }

  .video-testimonials__thumb-link {
    display: block;
    text-decoration: none;
    cursor: pointer;
  }

  .video-testimonials__thumb-link--noop {
    cursor: default;
  }

  .video-testimonials__thumb-wrap {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 18px;
    overflow: hidden;
    background: #111827;
  }

  .video-testimonials__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .video-testimonials__thumb--placeholder {
    background: linear-gradient(135deg, #1a2840 0%, #111827 100%);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 16px;
  }
  .video-testimonials__thumb--placeholder::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 30% 70%, rgba(255,255,255,0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .video-testimonials__placeholder-label {
    position: relative;
    z-index: 1;
    font-family: var(--tcc-font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: rgba(255,255,255,0.85);
    text-transform: uppercase;
  }

  .video-testimonials__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .video-testimonials__play-circle {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(255,255,255,0.92);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0,0,0,0.18);
    padding-left: 3px;
  }

  .video-testimonials__thumb-link:hover .video-testimonials__play-circle {
    background: #ffffff;
  }

  .video-testimonials__duration {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(0,0,0,0.55);
    color: #fff;
    font-family: var(--tcc-font-sans);
    font-size: 12px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.3px;
  }

  /* --- CTA + Guarantee --- */
  .video-testimonials__cta-wrap {
    margin-top: var(--tcc-s-5, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .video-testimonials__cta {
    display: inline-block;
    background: #095946;
    color: #f6f9fe;
    font-family: var(--tcc-font-sans);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.36px;
    text-decoration: none;
    padding: 20px 64px;
    border-radius: 30px;
    line-height: 1;
    width: 100%;
    max-width: 620px;
    text-align: center;
    box-sizing: border-box;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .video-testimonials__cta:hover {
    background: #0a6750;
  }
  .video-testimonials__cta:active {
    transform: scale(0.99);
  }
  .video-testimonials__cta--noop {
    cursor: default;
  }

  .video-testimonials__guarantee {
    margin: 16px 0 0;
    font-family: var(--tcc-font-sans);
    font-size: 14px;
    font-weight: 500;
    color: #4b5563;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
  }
  .video-testimonials__shield {
    color: #4b5563;
    flex-shrink: 0;
  }

  /* --- Tablet (989px) --- */
  @media screen and (max-width: 989px) {
    .video-testimonials__heading {
      font-size: 28px;
      line-height: 34px;
    }
    .video-testimonials__track,
    .video-testimonials__track--horizontal,
    .video-testimonials__track--grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .video-testimonials__nav {
      grid-template-columns: 40px 1fr 40px;
      gap: 12px;
    }
    .video-testimonials__arrow {
      width: 40px;
      height: 40px;
    }
  }

  /* --- Mobile (599px) --- */
  @media screen and (max-width: 599px) {
    .video-testimonials__heading {
      font-size: 24px;
      line-height: 30px;
    }

    .video-testimonials__nav {
      display: block;
    }
    .video-testimonials__arrow {
      display: none;
    }

    .video-testimonials__track,
    .video-testimonials__track--horizontal,
    .video-testimonials__track--grid {
      display: flex;
      grid-template-columns: none;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 4px;
      padding-right: 16px;
    }
    .video-testimonials__track::-webkit-scrollbar {
      display: none;
    }
    .video-testimonials__card {
      flex: 0 0 70vw;
      scroll-snap-align: start;
    }

    .video-testimonials__play-circle {
      width: 54px;
      height: 54px;
    }

    .video-testimonials__cta {
      width: 100%;
      min-width: 0;
      padding: 18px 24px;
      font-size: 16px;
    }
  }
</style>

<script>
  (function() {
    var roots = document.querySelectorAll('[data-section-type="video-testimonials"]');
    roots.forEach(function(root) {
      var track = root.querySelector('[data-vt-track]');
      var prev = root.querySelector('[data-vt-prev]');
      var next = root.querySelector('[data-vt-next]');
      if (!track || !prev || !next) return;

      function scrollBy(dir) {
        var firstCard = track.querySelector('.video-testimonials__card');
        var step = firstCard ? firstCard.getBoundingClientRect().width + 16 : 280;
        track.scrollBy({ left: dir * step, behavior: 'smooth' });
      }
      prev.addEventListener('click', function() { scrollBy(-1); });
      next.addEventListener('click', function() { scrollBy(1); });
    });
  })();
</script>

{% schema %}
{
  "name": "Video Testimonials",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See Why This Centuries-Old Enzyme Is Trusted Daily for Cardiovascular Health"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "horizontal", "label": "Horizontal (4-up grid + side arrows)" },
        { "value": "grid", "label": "Grid (4-up)" }
      ],
      "default": "horizontal"
    },
    {
      "type": "header",
      "content": "CTA + Guarantee"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show CTA + guarantee row below videos",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "BUY NOW & SAVE"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "30-Day Money Back Guarantee"
    }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video card",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (YouTube/Vimeo/direct mp4)"
        },
        {
          "type": "text",
          "id": "duration",
          "label": "Duration text",
          "default": "1:24"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Testimonials",
      "blocks": [
        { "type": "video_card", "settings": { "name": "Shaun", "caption": "His story.", "duration": "1:24" } },
        { "type": "video_card", "settings": { "name": "Gina", "caption": "Her story.", "duration": "0:56" } },
        { "type": "video_card", "settings": { "name": "Taylor", "caption": "Their story.", "duration": "1:12" } },
        { "type": "video_card", "settings": { "name": "James", "caption": "His recovery.", "duration": "1:38" } }
      ]
    }
  ]
}
{% endschema %}
