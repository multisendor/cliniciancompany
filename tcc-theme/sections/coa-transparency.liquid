<div
  data-section-type="coa-transparency"
  data-section-id="{{ section.id }}"
  class="coa-transparency tcc-section-padding"
  id="coa-transparency"
>
  <div class="tcc-page-width">
    <div class="coa-transparency__card">
      <div class="coa-transparency__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="coa-transparency__eyebrow tcc-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="coa-transparency__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="coa-transparency__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- if section.settings.lookup_enabled -%}
          <form class="coa-transparency__lookup" action="{{ section.settings.cta_link | default: '/pages/coa' }}" method="get" novalidate>
            <label for="coa-lookup-{{ section.id }}" class="coa-transparency__lookup-label">
              {{ section.settings.input_label | default: "Bottle lot number" }}
            </label>
            <div class="coa-transparency__lookup-row">
              <input
                id="coa-lookup-{{ section.id }}"
                class="coa-transparency__input"
                type="text"
                name="lot"
                placeholder="{{ section.settings.input_placeholder | default: 'e.g. ND4-2026-A12' }}"
                autocomplete="off"
                spellcheck="false"
              >
              <button type="submit" class="coa-transparency__button">
                {{ section.settings.cta_text | default: "Look up my batch" }}
                <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
              </button>
            </div>
            <p class="coa-transparency__hint">{{ section.settings.hint_text | default: "Lot number is printed on the bottom of every bottle." }}</p>
          </form>
        {%- else -%}
          <a class="coa-transparency__button coa-transparency__button--solo" href="{{ section.settings.cta_link | default: '/pages/coa' }}">
            {{ section.settings.cta_text | default: "Look up my batch" }}
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </a>
        {%- endif -%}

        <ul class="coa-transparency__chips" aria-label="What every batch is tested for">
          {%- if section.settings.chip_1 != blank -%}
            <li class="coa-transparency__chip">
              <span class="material-symbols-outlined" aria-hidden="true">science</span>
              {{ section.settings.chip_1 }}
            </li>
          {%- endif -%}
          {%- if section.settings.chip_2 != blank -%}
            <li class="coa-transparency__chip">
              <span class="material-symbols-outlined" aria-hidden="true">monitoring</span>
              {{ section.settings.chip_2 }}
            </li>
          {%- endif -%}
          {%- if section.settings.chip_3 != blank -%}
            <li class="coa-transparency__chip">
              <span class="material-symbols-outlined" aria-hidden="true">shield</span>
              {{ section.settings.chip_3 }}
            </li>
          {%- endif -%}
        </ul>
      </div>

      <aside class="coa-transparency__seal" aria-hidden="true">
        <div class="coa-transparency__seal-ring">
          <div class="coa-transparency__seal-inner">
            <span class="coa-transparency__seal-eyebrow">Per-Lot</span>
            <span class="coa-transparency__seal-word">COA</span>
            <span class="coa-transparency__seal-sub">Published</span>
          </div>
        </div>
        <div class="coa-transparency__seal-meta">
          <span class="material-symbols-outlined">verified</span>
          <span>Independently verified · 3rd-party lab</span>
        </div>
      </aside>
    </div>
  </div>
</div>

<style>
  .coa-transparency {
    background: var(--tcc-bg);
  }

  .coa-transparency__card {
    background: var(--tcc-card);
    border: 1px solid var(--tcc-line);
    border-radius: calc(var(--tcc-radius) * 2);
    box-shadow: var(--tcc-shadow-card);
    padding: var(--tcc-s-8) var(--tcc-s-6);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--tcc-s-8);
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
  }

  .coa-transparency__card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(10, 22, 40, 0.025) 0%, rgba(10, 22, 40, 0) 60%);
    pointer-events: none;
  }

  .coa-transparency__content {
    position: relative;
  }

  .coa-transparency__eyebrow {
    margin: 0 0 var(--tcc-s-2);
  }

  .coa-transparency__heading {
    font-size: var(--tcc-fs-h1);
    font-weight: var(--tcc-fw-display);
    letter-spacing: var(--tcc-ls-display);
    line-height: var(--tcc-lh-tight);
    color: var(--tcc-ink);
    margin: 0 0 var(--tcc-s-3);
    max-width: 18ch;
  }

  .coa-transparency__subheading {
    font-size: var(--tcc-fs-body);
    line-height: var(--tcc-lh-body);
    color: var(--tcc-ink-soft);
    margin: 0 0 var(--tcc-s-4);
    max-width: 52ch;
  }

  .coa-transparency__lookup {
    margin: 0 0 var(--tcc-s-4);
  }

  .coa-transparency__lookup-label {
    display: block;
    font-size: var(--tcc-fs-eyebrow);
    font-weight: var(--tcc-fw-bold);
    letter-spacing: var(--tcc-ls-eyebrow);
    text-transform: uppercase;
    color: var(--tcc-ink-soft);
    margin-bottom: var(--tcc-s-1);
  }

  .coa-transparency__lookup-row {
    display: flex;
    gap: var(--tcc-s-1);
    background: var(--tcc-bg);
    border: 1px solid var(--tcc-line);
    border-radius: var(--tcc-radius);
    padding: 6px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .coa-transparency__lookup-row:focus-within {
    border-color: var(--tcc-ink);
    box-shadow: 0 0 0 3px rgba(10, 22, 40, 0.08);
  }

  .coa-transparency__input {
    flex: 1;
    border: 0;
    background: transparent;
    font-family: var(--tcc-font-sans);
    font-size: var(--tcc-fs-body);
    color: var(--tcc-ink);
    padding: 10px 12px;
    outline: none;
    min-width: 0;
  }

  .coa-transparency__input::placeholder {
    color: var(--tcc-ink-soft);
    opacity: 0.6;
  }

  .coa-transparency__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: var(--tcc-ink);
    color: var(--tcc-bg);
    border: 0;
    border-radius: calc(var(--tcc-radius) - 1px);
    font-family: var(--tcc-font-sans);
    font-weight: var(--tcc-fw-bold);
    font-size: var(--tcc-fs-small);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .coa-transparency__button:hover {
    opacity: 0.92;
    transform: translateY(-1px);
    color: var(--tcc-bg);
  }

  .coa-transparency__button .material-symbols-outlined {
    font-size: 18px;
    font-variation-settings: 'FILL' 0, 'wght' 600;
  }

  .coa-transparency__button--solo {
    margin: 0 0 var(--tcc-s-4);
  }

  .coa-transparency__hint {
    margin: var(--tcc-s-1) 0 0;
    font-size: var(--tcc-fs-small);
    color: var(--tcc-ink-soft);
  }

  .coa-transparency__chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--tcc-s-1);
  }

  .coa-transparency__chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--tcc-bg);
    border: 1px solid var(--tcc-line);
    border-radius: 999px;
    padding: 8px 14px;
    font-size: var(--tcc-fs-small);
    font-weight: var(--tcc-fw-medium);
    color: var(--tcc-ink);
  }

  .coa-transparency__chip .material-symbols-outlined {
    font-size: 16px;
    color: var(--tcc-ink-soft);
    font-variation-settings: 'FILL' 0, 'wght' 500;
  }

  /* Seal — CSS-only badge */
  .coa-transparency__seal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--tcc-s-2);
    position: relative;
  }

  .coa-transparency__seal-ring {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.9) 0%, rgba(248, 250, 252, 0) 60%),
      conic-gradient(from 220deg, #0a1628 0%, #1c3553 25%, #0a1628 50%, #1c3553 75%, #0a1628 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      inset 0 0 0 6px rgba(255, 255, 255, 0.95),
      inset 0 0 0 7px var(--tcc-line),
      0 12px 32px rgba(10, 22, 40, 0.18);
    position: relative;
  }

  .coa-transparency__seal-ring::before {
    content: "";
    position: absolute;
    inset: 14px;
    border-radius: 50%;
    border: 1px dashed rgba(255, 255, 255, 0.35);
  }

  .coa-transparency__seal-inner {
    text-align: center;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  .coa-transparency__seal-eyebrow {
    font-size: 10px;
    font-weight: var(--tcc-fw-bold);
    text-transform: uppercase;
    letter-spacing: 3px;
    opacity: 0.7;
    margin-bottom: 6px;
  }

  .coa-transparency__seal-word {
    font-size: 56px;
    font-weight: var(--tcc-fw-display);
    letter-spacing: -2px;
    margin-bottom: 4px;
  }

  .coa-transparency__seal-sub {
    font-size: 11px;
    font-weight: var(--tcc-fw-bold);
    text-transform: uppercase;
    letter-spacing: 2.5px;
    opacity: 0.85;
  }

  .coa-transparency__seal-meta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--tcc-fs-small);
    color: var(--tcc-ink-soft);
  }

  .coa-transparency__seal-meta .material-symbols-outlined {
    font-size: 16px;
    color: var(--tcc-positive);
    font-variation-settings: 'FILL' 1, 'wght' 600;
  }

  @media screen and (max-width: 900px) {
    .coa-transparency__card {
      grid-template-columns: 1fr;
      gap: var(--tcc-s-6);
      padding: var(--tcc-s-6) var(--tcc-s-4);
      text-align: left;
    }

    .coa-transparency__seal {
      order: -1;
    }

    .coa-transparency__seal-ring {
      width: 160px;
      height: 160px;
    }

    .coa-transparency__seal-word {
      font-size: 40px;
    }
  }

  @media screen and (max-width: 540px) {
    .coa-transparency__card {
      padding: var(--tcc-s-4) var(--tcc-s-3);
    }

    .coa-transparency__heading {
      font-size: 28px;
    }

    .coa-transparency__lookup-row {
      flex-direction: column;
      padding: 8px;
    }

    .coa-transparency__button {
      width: 100%;
      justify-content: center;
    }
  }
</style>

{% schema %}
{
  "name": "COA Transparency",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Per-Lot Transparency"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every batch tested. Every COA published."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find your bottle's lot number on the label and download the certificate of analysis for that exact batch."
    },
    {
      "type": "checkbox",
      "id": "lookup_enabled",
      "label": "Show lookup input",
      "default": true
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Input label",
      "default": "Bottle lot number"
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input placeholder",
      "default": "e.g. ND4-2026-A12"
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Hint text",
      "default": "Lot number is printed on the bottom of every bottle."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Look up my batch"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link",
      "default": "/pages/coa"
    },
    {
      "type": "header",
      "content": "Test chips (3)"
    },
    {
      "type": "text",
      "id": "chip_1",
      "label": "Chip 1",
      "default": "Identity"
    },
    {
      "type": "text",
      "id": "chip_2",
      "label": "Chip 2",
      "default": "Potency (FU activity)"
    },
    {
      "type": "text",
      "id": "chip_3",
      "label": "Chip 3",
      "default": "Heavy metals & contaminants"
    }
  ],
  "presets": [
    {
      "name": "COA Transparency"
    }
  ]
}
{% endschema %}
